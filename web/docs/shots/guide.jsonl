// Sortiment: one product by hand, the rest per CSV
{ "do": "tab", "header": "3. Sortiment" }
{ "do": "choose", "at": { "name": "CatalogBox" }, "text": "Bier 0,5", "item": "Bier 0,5 l vom Fass" }
{ "do": "focus" }
{ "do": "shot", "name": "sortiment-erstes", "at": { "text": "Produkt", "up": "DataGrid" }, "clip": "DataGridRow", "trim": { "top": 5 } }
{ "do": "type", "at": { "text": "Bier 0,5 l vom Fass", "up": "DataGridRow" }, "text": "4,60" }
{ "do": "focus" }

{ "do": "shot", "name": "sortiment-kopf", "at": { "tip": "CSV importieren", "up": "Grid" }, "trim": { "bottom": 5 } }
{ "do": "pick", "files": ["web/docs/pages/guide/sortiment-gasthaus.csv"] }
{ "do": "click", "at": { "tip": "CSV importieren" } }
{ "do": "wait", "rounds": 2 }
{ "do": "shot", "name": "sortiment-liste", "at": { "text": "Produkt", "up": "DataGrid" }, "clip": "DataGridRow", "trim": { "top": 5 } }

