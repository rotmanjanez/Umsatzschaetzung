// The example case from the guide: created, filled with all 106 invoices, the three
// open ones corrected, the open positions mapped, the assortment built, the report shown.

{ "do": "shot", "name": "neue-pruefung-knopf", "at": { "text": "Neue Prüfung", "up": "DockPanel" } }

{ "do": "click", "at": { "text": "Neue Prüfung" } }
{ "do": "focus" }
{ "do": "shot", "name": "neue-pruefung", "at": { "name": "NewLabel", "up": "StackPanel" } }

{ "do": "type", "at": { "name": "NewLabel" }, "text": "Gasthaus Zur Linde, Bp 2025" }
{ "do": "type", "at": { "name": "NewFrom" }, "text": "01.01.2025" }
{ "do": "type", "at": { "name": "NewTo" }, "text": "31.12.2025" }
{ "do": "type", "at": { "name": "NewName" }, "text": "Gasthaus Zur Linde, Inh. Renate Vogel e.K." }
{ "do": "type", "at": { "name": "NewTaxNumber" }, "text": "203/128/40507" }
{ "do": "type", "at": { "name": "NewPab" }, "text": "PaB 2025/0417" }
{ "do": "click", "at": { "text": "Anlegen" } }

{ "do": "shot", "name": "pruefung-kopf", "at": { "name": "CaseLabel", "up": "DockPanel" }, "trim": { "bottom": -56 } }
{ "do": "shot", "name": "pruefung-leer", "at": { "text": "Erklärte Umsätze, netto in €", "up": "TabControl" }, "trim": { "top": 16 } }

{ "do": "type", "at": { "name": "Declared19" }, "text": "196.418,00" }
{ "do": "focus" }
{ "do": "shot", "name": "erklaerte-umsaetze", "at": { "name": "Declared19", "up": "Grid" }, "trim": { "top": -30 } }

// Rechnungen: the whole year at once, three scans do not add up
{ "do": "tab", "header": "1. Rechnungen" }
{ "do": "shot", "name": "rechnungen-leer", "at": { "text": "1. Rechnungen", "up": "TabControl" }, "trim": { "top": 16 } }

{ "do": "import", "files": ["beispiel-rechnungen"] }
{ "do": "shot", "name": "rechnungen-import", "window": "dialog" }
{ "do": "click", "window": "dialog", "at": { "text": "Schließen" } }

{ "do": "deselect", "at": { "text": "Lieferant", "up": "DataGrid" } }
{ "do": "shot", "name": "rechnungen-liste", "at": { "text": "Lieferant", "up": "DataGrid" }, "clip": "DataGridRow" }

// Korrektur: a missing unit, a misread digit, a torn line
