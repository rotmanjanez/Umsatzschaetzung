// The example case from the guide: created, filled with all 106 invoices, the three
// open one corrected, the open positions mapped, the assortment built, the report shown.

{ "do": "shot", "name": "neue-pruefung-knopf", "at": { "text": "Neue Prüfung", "up": "DockPanel" } }

{ "do": "click", "at": { "text": "Neue Prüfung" } }
{ "do": "focus" }
{ "do": "shot", "name": "neue-pruefung", "at": { "name": "NewLabel", "up": "StackPanel" } }

{ "do": "type", "at": { "name": "NewLabel" }, "text": "Gasthaus Zur Linde, Bp 2025" }
{ "do": "type", "at": { "name": "NewFrom" }, "text": "01.01.2025" }
{ "do": "type", "at": { "name": "NewTo" }, "text": "31.12.2025" }
{ "do": "type", "at": { "name": "NewName" }, "text": "Gasthaus Zur Linde, Inh. Renate Vogel e.K." }
{ "do": "type", "at": { "name": "NewTaxNumber" }, "text": "203/128/40507" }
{ "do": "type", "at": { "name": "NewPab" }, "text": "PAB 2025/0417" }
{ "do": "click", "at": { "text": "Anlegen" } }

{ "do": "shot", "name": "pruefung-kopf", "at": { "name": "CaseLabel", "up": "DockPanel" }, "trim": { "bottom": -56 } }
{ "do": "shot", "name": "pruefung-leer", "at": { "text": "Erklärte Umsätze, netto in €", "up": "TabControl" }, "trim": { "top": 16 } }

{ "do": "type", "at": { "name": "Declared19Box" }, "text": "196.418,00" }
{ "do": "focus" }
{ "do": "shot", "name": "erklaerte-umsaetze", "at": { "name": "Declared19Box", "up": "Grid" }, "trim": { "top": -30 } }

// Rechnungen: the whole year at once, three scans do not add up
{ "do": "tab", "header": "1. Rechnungen" }
{ "do": "shot", "name": "rechnungen-leer", "at": { "text": "1. Rechnungen", "up": "TabControl" }, "trim": { "top": 16 } }

{ "do": "import", "files": ["beispiel-rechnungen"] }
{ "do": "shot", "name": "rechnungen-import", "window": "dialog" }
{ "do": "click", "window": "dialog", "at": { "text": "Schließen" } }

{ "do": "deselect", "at": { "text": "Lieferant", "up": "DataGrid" } }
{ "do": "shot", "name": "rechnungen-liste", "at": { "text": "Lieferant", "up": "DataGrid" }, "clip": "DataGridRow" }

// Korrektur: the frozen-goods invoice, its last line lost under the stamp
{ "do": "open", "number": "TK25-1583" }
{ "do": "wait", "rounds": 2 }
{ "do": "shot", "name": "korrektur-tk", "window": "dialog" }
{ "do": "shot", "name": "korrektur-tk-beleg", "window": "dialog", "at": { "name": "ScanPane" }, "trim": { "top": 540, "bottom": 190 } }
{ "do": "click", "window": "dialog", "at": { "tip": "Zeile hinzufügen" } }
{ "do": "edit", "window": "dialog", "at": { "text": "0,00 €" }, "column": "Menge", "text": "6" }
{ "do": "edit", "window": "dialog", "at": { "text": "0,00 €" }, "column": "Einheit", "text": "Stück" }
{ "do": "edit", "window": "dialog", "at": { "text": "0,00 €" }, "column": "Position", "text": "Thermobox Leihgebühr je Woche" }
{ "do": "edit", "window": "dialog", "at": { "text": "0,00 €" }, "column": "Einzelpreis", "text": "3,50" }
{ "do": "edit", "window": "dialog", "at": { "text": "0,00 €" }, "column": "Netto", "text": "21,00" }
{ "do": "type", "window": "dialog", "at": { "name": "SupplierBox" }, "text": "Frostwerk Tiefkühl-Service GmbH" }
{ "do": "focus", "window": "dialog" }
{ "do": "deselect", "window": "dialog", "at": { "name": "Lines" } }
{ "do": "wait", "rounds": 2 }
{ "do": "shot", "name": "korrektur-tk-zeile", "window": "dialog", "at": { "name": "FormPane" }, "clip": "DataGridRow", "trim": { "bottom": -16 } }

{ "do": "edit", "window": "dialog", "at": { "text": "18,90 €" }, "column": "USt", "text": "7" }
{ "do": "edit", "window": "dialog", "at": { "text": "23,40 €" }, "column": "USt", "text": "7" }
{ "do": "edit", "window": "dialog", "at": { "text": "25,80 €" }, "column": "USt", "text": "7" }
{ "do": "edit", "window": "dialog", "at": { "text": "1,24 €" }, "column": "USt", "text": "7" }
{ "do": "edit", "window": "dialog", "at": { "text": "41,50 €" }, "column": "USt", "text": "7" }
{ "do": "edit", "window": "dialog", "at": { "text": "26,40 €" }, "column": "USt", "text": "7" }
{ "do": "edit", "window": "dialog", "at": { "text": "32,50 €" }, "column": "USt", "text": "19" }
{ "do": "edit", "window": "dialog", "at": { "text": "Thermobox Leihgebühr je Woche" }, "column": "USt", "text": "19" }
{ "do": "deselect", "window": "dialog", "at": { "name": "Lines" } }
{ "do": "wait", "rounds": 2 }
{ "do": "shot", "name": "korrektur-tk-fertig", "window": "dialog", "at": { "name": "FormPane" }, "clip": "DataGridRow", "trim": { "bottom": -16 } }
{ "do": "click", "window": "dialog", "at": { "name": "AcceptInvoice" } }
{ "do": "wait", "rounds": 2 }

{ "do": "deselect", "at": { "text": "Lieferant", "up": "DataGrid" } }
{ "do": "shot", "name": "korrektur-liste-fertig", "at": { "starts": "0 offen", "up": "DockPanel" } }

// Zuordnung: five open positions, then the kegs the program took for bottled beer
{ "do": "tab", "header": "2. Zuordnung" }
{ "do": "wait", "rounds": 8 }
{ "do": "shot", "name": "zuordnung-liste", "at": { "name": "Groups", "up": "MappingView" }, "trim": { "bottom": 371 } }

{ "do": "select", "at": { "starts": "2022 Domina" } }
{ "do": "wait", "rounds": 20 }
{ "do": "shot", "name": "zuordnung-position", "at": { "name": "Groups", "up": "MappingView" } }
{ "do": "click", "at": { "text": "Rotwein × 750 ml" } }
{ "do": "wait", "rounds": 2 }
{ "do": "click", "at": { "text": "Zuordnen" } }
{ "do": "wait", "rounds": 8 }
{ "do": "shot", "name": "zuordnung-zugeordnet", "at": { "starts": "„2022 Domina", "up": "Border" } }

{ "do": "top", "at": { "name": "Groups" } }
{ "do": "select", "at": { "starts": "Frühkartoffeln" } }
{ "do": "wait", "rounds": 20 }
{ "do": "click", "at": { "text": "Zuordnen" } }
{ "do": "wait", "rounds": 8 }

{ "do": "top", "at": { "name": "Groups" } }
{ "do": "select", "at": { "starts": "Kaffeesahne" } }
{ "do": "wait", "rounds": 20 }
{ "do": "shot", "name": "zuordnung-faktor-fehlt", "at": { "text": "AUS DEN REGELN", "up": "Border" } }
{ "do": "type", "at": { "name": "FactorBox" }, "text": "1800" }
{ "do": "focus" }
{ "do": "wait", "rounds": 2 }
{ "do": "shot", "name": "zuordnung-faktor", "at": { "text": "AUS DEN REGELN", "up": "Border" } }
{ "do": "click", "at": { "text": "Zuordnen" } }
{ "do": "wait", "rounds": 8 }

{ "do": "deselect", "at": { "name": "Groups" } }
{ "do": "shot", "name": "zuordnung-fertig", "at": { "starts": "1 offen", "up": "DockPanel" } }


// Sortiment: one product by hand, the rest per CSV
{ "do": "tab", "header": "3. Sortiment" }
{ "do": "choose", "at": { "name": "CatalogBox" }, "text": "Bier 0,5", "item": "Bier 0,5 l vom Fass" }
{ "do": "focus" }
{ "do": "shot", "name": "sortiment-erstes", "at": { "text": "Produkt", "up": "DataGrid" }, "clip": "DataGridRow", "trim": { "top": 5 } }
{ "do": "type", "at": { "text": "Bier 0,5 l vom Fass", "up": "DataGridRow" }, "text": "4,60" }
{ "do": "focus" }

{ "do": "shot", "name": "sortiment-kopf", "at": { "tip": "CSV importieren", "up": "Grid" }, "trim": { "bottom": 5 } }
{ "do": "pick", "files": ["web/docs/pages/guide/sortiment-gasthaus.csv"] }
{ "do": "click", "at": { "tip": "CSV importieren" } }
{ "do": "wait", "rounds": 2 }
{ "do": "shot", "name": "sortiment-liste", "at": { "text": "Produkt", "up": "DataGrid" }, "clip": "DataGridRow", "trim": { "top": 5, "bottom": 465 } }

// Danach: back in the list, the case is there to reopen
{ "do": "click", "at": { "name": "BackButton" } }
{ "do": "deselect", "at": { "text": "Bezeichnung", "up": "DataGrid" } }
{ "do": "shot", "name": "pruefungen-wieder", "at": { "text": "Bezeichnung", "up": "DataGrid" }, "trim": { "top": 16 }, "clip": "DataGridRow" }
