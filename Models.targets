<Project>
  <!-- The weights live in their own GitHub releases, not in the repo: 133 MB of LFS
       burned the free bandwidth allowance in a single push to main, and every retrain
       would have cost another 133 MB of LFS storage that no rewrite gives back.
       Release assets have neither quota.

       Each file is pinned by SHA256. A mismatch deletes the cached copy and fails the
       build, so a truncated download heals on the next run instead of being baked into
       an installer. -->
  <ItemGroup>
    <ModelFile Include="belegtagger.int8.onnx;vocab.json;merges.txt;byte_to_unicode.json;spec.json">
      <Dir>belegtagger</Dir>
      <Release>belegtagger-v1.0.0</Release>
    </ModelFile>
    <ModelFile Include="PP-OCRv6_det_small.onnx">
      <Dir>v6</Dir>
      <Release>ppocr-v6.0.0</Release>
    </ModelFile>

    <ModelFile Update="belegtagger.int8.onnx" Sha256="20e008dc763f0be6332b343d348de1fc22461d05fedb5b7a58433c56cd5a22ca" />
    <ModelFile Update="vocab.json" Sha256="58f7ec138a70ded60140087b6ae1a7a63bcbd16c4b59fd128fb2fc49b2b8aeb0" />
    <ModelFile Update="merges.txt" Sha256="92f04b1cfffbdfc3495a01f2cce2a81c874d1bfa255ea3859f6f0d43356ac57f" />
    <ModelFile Update="byte_to_unicode.json" Sha256="cbb1623eed136cceb032401db5efec4d36c8e1608810c0e7d4ef533d586960df" />
    <ModelFile Update="spec.json" Sha256="37f94f042c4bb411ba9de2413a2b2b5783c567489caeb889f4a5f7ada4b7e05a" />
    <ModelFile Update="PP-OCRv6_det_small.onnx" Sha256="090f04abcd9d9a7498bc4ebf677e4cb9bdce1fe4197ddb7e529f1ef44e1ff94f" />
  </ItemGroup>

  <PropertyGroup>
    <ModelRepository Condition="'$(ModelRepository)' == ''">https://github.com/rotmanjanez/Umsatzschaetzung/releases/download</ModelRepository>
    <!-- Set UMSATZ_MODEL_DIR to a pre-populated cache to build without network. -->
    <ModelCacheDir Condition="'$(ModelCacheDir)' == ''">$(UMSATZ_MODEL_DIR)</ModelCacheDir>
    <ModelCacheDir Condition="'$(ModelCacheDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))/umsatzschaetzung/models</ModelCacheDir>
  </PropertyGroup>

  <Target Name="FetchModels" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <ModelFile>
        <Path>$(ModelCacheDir)/%(ModelFile.Release)/%(ModelFile.Dir)/%(ModelFile.Identity)</Path>
      </ModelFile>
      <MissingModel Include="@(ModelFile)" Condition="!Exists('%(ModelFile.Path)')" />
    </ItemGroup>

    <Error Condition="'@(MissingModel)' != '' AND '$(UMSATZ_MODEL_DIR)' != ''"
           Text="Missing under UMSATZ_MODEL_DIR ($(ModelCacheDir)): @(MissingModel->'%(Release)/%(Dir)/%(Identity)', ', ')" />

    <Message Importance="high" Condition="'@(MissingModel)' != ''"
             Text="Fetching @(MissingModel->Count()) model file(s) into $(ModelCacheDir)" />
    <DownloadFile Condition="'@(MissingModel)' != ''"
                  SourceUrl="$(ModelRepository)/%(MissingModel.Release)/%(MissingModel.Identity)"
                  DestinationFolder="$(ModelCacheDir)/%(MissingModel.Release)/%(MissingModel.Dir)"
                  DestinationFileName="%(MissingModel.Identity)"
                  Retries="3" />

    <GetFileHash Files="@(ModelFile->'%(Path)')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="HashedModel" />
    </GetFileHash>
    <ItemGroup>
      <CorruptModel Include="@(HashedModel)" Condition="'%(HashedModel.FileHash)' != '%(HashedModel.Sha256)'" />
    </ItemGroup>
    <Delete Files="@(CorruptModel)" Condition="'@(CorruptModel)' != ''" />
    <Error Condition="'@(CorruptModel)' != ''"
           Text="SHA256 mismatch, cached copy discarded — build again to re-fetch: @(CorruptModel->'%(Identity)', ', ')" />

    <ItemGroup>
      <ContentWithTargetPath Include="@(ModelFile->'%(Path)')"
                             TargetPath="models/%(ModelFile.Dir)/%(ModelFile.Identity)"
                             CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
