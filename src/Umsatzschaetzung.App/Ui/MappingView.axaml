<ui:Screen x:Class="Umsatzschaetzung.App.Ui.MappingView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           x:DataType="ui:MappingModel"
           Margin="0,12,0,0">
    <ui:Screen.Styles>
        <Style Selector="Border.state.auto">
            <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
        </Style>
        <Style Selector="Border.state.manual">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
        </Style>
        <Style Selector="Border.state.pending">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
        </Style>
        <Style Selector="DataGridRow TextBlock.cell">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </ui:Screen.Styles>
    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="52*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Theme="{StaticResource Panel}" ClipToBounds="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8">
                        <ui:SearchBox x:Name="Search" DockPanel.Dock="Right"/>
                        <Panel Margin="4,0,12,0">
                            <TextBlock Text="{Binding Summary}" Theme="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !Mapping}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding Mapping}">
                                <PathIcon Theme="{StaticResource Spinner}" Margin="0,0,6,0"/>
                                <TextBlock Text="Wird zugeordnet …" Theme="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Panel>
                    </DockPanel>
                    <Grid>
                    <DataGrid x:Name="Groups" ui:Blur.Detail="{Binding #Detail}" ui:Grids.Flex="1" Theme="{StaticResource Grid}" IsReadOnly="True"
                              SelectionChanged="GroupSelected" IsVisible="{Binding !NoInvoices}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Rank">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:LineGroup">
                                        <Border Theme="{StaticResource Badge}" Classes="state" Margin="8,0"
                                                Classes.auto="{Binding IsAutomatic}" Classes.manual="{Binding IsManual}" Classes.pending="{Binding IsPending}">
                                            <TextBlock Text="{Binding StateText}" Theme="{StaticResource BadgeText}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Position" Width="*" MinWidth="120" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:LineGroup">
                                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" ToolTip.Tip="{Binding Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Lieferant" Width="150" SortMemberPath="Supplier">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:LineGroup">
                                        <TextBlock Classes="cell" Text="{Binding Supplier}" Theme="{StaticResource Muted}" ToolTip.Tip="{Binding Supplier}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsVisible="{Binding NoInvoices}">
                        <TextBlock Text="Noch keine Rechnungen" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Zugeordnet werden Rechnungspositionen zu Zutaten. Fügen Sie zuerst Rechnungen hinzu."/>
                        <Button Content="Zu den Rechnungen" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="GoInvoices"/>
                    </StackPanel>
                    <ui:NoResults Search="{Binding #Search}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Theme="{StaticResource Panel}" Padding="16">
                <ui:MappingDetail x:Name="Detail"/>
            </Border>
        </Grid>
    </DockPanel>
</ui:Screen>
