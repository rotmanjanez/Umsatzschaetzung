<ui:Screen x:Class="Umsatzschaetzung.App.Ui.CalcView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           x:DataType="ui:CalcModel"
           Margin="0,12,0,0">
    <ui:Screen.Styles>
        <Style Selector="DataGrid#RevenueGrid DataGridRow">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="DataGrid#MarkupGrid DataGridRow">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.total">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ui:Screen.Styles>
    <ui:Screen.Resources>
        <DataTemplate x:Key="YieldGroupTemplate" x:DataType="ui:YieldKindGroup">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding Kind}" Theme="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:YieldGroupRow">
                            <Grid ColumnDefinitions="260,16,*" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:RuleOption">
                                            <TextBlock Text="{Binding Text}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </ui:Screen.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Right" Text="Wird neu berechnet …" Theme="{StaticResource Muted}" Margin="0,0,0,16" IsVisible="{Binding Busy}"/>
        <Grid>
            <TextBlock Text="Wird berechnet …" Theme="{StaticResource EmptyState}" IsVisible="{Binding Calculating}"/>
            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding NoInvoices}">
                <TextBlock Text="Noch keine Datengrundlage" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Die Kalkulation leitet Portionen und Umsätze aus den zugeordneten Rechnungspositionen ab. Ohne Rechnungen gibt es nichts zu rechnen."/>
                <Button Content="Zu den Rechnungen" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="GoInvoices"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasResult}">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Verteilung" Theme="{StaticResource SectionHeader}"/>
                    <StackPanel MaxWidth="440" HorizontalAlignment="Left" Margin="0,0,0,24" IsVisible="{Binding EmptyAssortment}">
                        <TextBlock Theme="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Noch keine Produkte im Sortiment."/>
                        <Button Content="Zu den Produkten" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="GoProducts"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,24" IsVisible="{Binding !EmptyAssortment}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64*" MinWidth="360"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="36*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="ProductGrid" ui:Grids.Flex="0" Theme="{StaticResource Grid}" ItemsSource="{Binding Products}" IsReadOnly="True" MaxHeight="480"
                                  SelectionMode="Single" SelectionChanged="ProductSelected" VerticalAlignment="Top">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Produkt" Width="280" MinWidth="120" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ResultRow">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Theme="{StaticResource BadgeInfo}" IsVisible="{Binding Adjusted}" ToolTip.Tip="{Binding RecipeTip}">
                                                    <TextBlock Text="angepasst" Theme="{StaticResource BadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Portionen" Width="110" SortMemberPath="PortionsValue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ResultRow">
                                            <TextBlock Text="{Binding Portions}" Theme="{StaticResource Cell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Einsatz je Portion" Width="150" SortMemberPath="Cost">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ResultRow">
                                            <TextBlock Text="{Binding Cost}" Theme="{StaticResource Cell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Umsatz (netto)" Width="150" SortMemberPath="RevenueValue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ResultRow">
                                            <Panel>
                                                <TextBlock Text="{Binding Revenue}" Theme="{StaticResource Cell}"/>
                                                <Border Theme="{StaticResource BadgeWarning}" HorizontalAlignment="Right" IsVisible="{Binding PriceMissing}">
                                                    <TextBlock Text="Preis fehlt" Theme="{StaticResource BadgeText}"/>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Aufschlagsatz" Width="130" SortMemberPath="Markup">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ResultRow">
                                            <TextBlock Text="{Binding Markup}" Theme="{StaticResource Cell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                        <Border Grid.Column="2" Theme="{StaticResource Panel}" Padding="16" VerticalAlignment="Top">
                            <Grid>
                                <TextBlock Text="Kein Produkt gewählt" Theme="{StaticResource Muted}" IsVisible="{Binding NoDetail}"/>
                                <StackPanel IsVisible="{Binding !NoDetail}">
                                <StackPanel DataContext="{Binding Detail}" x:DataType="ui:ProductDetail">
                                    <TextBlock Text="{Binding Name}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Facts}" Margin="0,0,0,16" Grid.IsSharedSizeScope="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="ui:KV">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DetailKey"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Theme="{StaticResource KeyLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel DataContext="{Binding Editor}" x:DataType="ui:RecipeEditor">
                                    <StackPanel IsVisible="{Binding !Adjusted}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Rezeptur je Portion" Theme="{StaticResource FieldLabel}" Margin="0"/>
                                                <Border Theme="{StaticResource Badge}" ToolTip.Tip="Es gilt das Rezept aus dem Katalog.">
                                                    <TextBlock Text="Katalog" Theme="{StaticResource BadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Click="AdjustRecipe"
                                                    ToolTip.Tip="Für diese Prüfung anpassen&#10;Gilt nur in dieser Prüfung, der Katalog bleibt unverändert.">
                                                <PathIcon Data="{StaticResource EditIcon}" Width="14" Height="14"/>
                                            </Button>
                                            <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Margin="0" Click="EditCatalog"
                                                    ToolTip.Tip="Im Katalog bearbeiten&#10;Ändert das Rezept für alle Prüfungen.">
                                                <PathIcon Data="{StaticResource RulesIcon}" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Uses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="ui:RecipeUse">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Amount}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Note}" Theme="{StaticResource Muted}" TextWrapping="Wrap" IsVisible="{Binding HasNote}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Border IsVisible="{Binding Adjusted}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                                <TextBlock Text="Rezeptur für diese Prüfung" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Theme="{StaticResource BadgeInfo}" Margin="8,0,0,0"
                                                        ToolTip.Tip="Gilt nur in dieser Prüfung, der Katalog bleibt unverändert.">
                                                    <TextBlock Text="Nur diese Prüfung" Theme="{StaticResource BadgeText}"/>
                                                </Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="ui:CaseRecipeRow">
                                                        <StackPanel Margin="0,0,0,10">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <ui:IngredientBox Choices="{Binding Options}" SelectedItem="{Binding Ingredient, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                                <Button Grid.Column="1" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Zutat entfernen" Click="RemoveRecipeLine">
                                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                                                </Button>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,Auto,*" Margin="0,4,0,0">
                                                                <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Amount, Mode=TwoWay}" Classes.invalid="{Binding AmountInvalid}"/>
                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Units}" SelectedIndex="{Binding UnitIndex, Mode=TwoWay}"
                                                                          Width="120" Margin="6,0,0,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding CatalogValue}" Theme="{StaticResource Muted}" FontSize="12"
                                                                           Margin="10,0,0,0" IsVisible="{Binding Differs}"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Note}" Theme="{StaticResource Muted}" Margin="0,2,0,0" IsVisible="{Binding HasNote}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Ohne gültige Zutat bleibt die zuletzt gespeicherte Rezeptur in Kraft." Theme="{StaticResource Muted}"
                                                       FontSize="12" Margin="0,0,0,8" IsVisible="{Binding Emptied}"/>
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <Button Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="AddRecipeLine" ToolTip.Tip="Zutat hinzufügen">
                                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14"/>
                                                </Button>
                                                <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Click="PromoteRecipe"
                                                        ToolTip.Tip="In den Katalog übernehmen&#10;Macht diese Rezeptur zum Katalogrezept für alle Prüfungen.">
                                                    <PathIcon Data="{StaticResource PromoteIcon}" Width="14" Height="14"/>
                                                </Button>
                                                <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Margin="0" Foreground="{DynamicResource DangerBrush}" Click="ResetRecipe"
                                                        ToolTip.Tip="Auf Katalog zurücksetzen&#10;Verwirft die Rezeptur dieser Prüfung, danach gilt das Katalogrezept.">
                                                    <PathIcon Data="{StaticResource ResetIcon}" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="Katalogrezept seit der Anpassung geändert" Theme="{StaticResource Muted}" Margin="0,10,0,0" IsVisible="{Binding Stale}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail.Note}" Theme="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding Detail.HasNote}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="Umsätze vor und nach Betriebsprüfung" Theme="{StaticResource SectionHeader}"/>
                    <DataGrid x:Name="RevenueGrid" ui:Grids.Flex="0" Margin="0,0,0,24" Theme="{StaticResource Grid}" ItemsSource="{Binding Revenue}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Steuersatz" Width="220" MinWidth="120" SortMemberPath="Vat">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Vat}" Classes.total="{Binding Total}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Umsatz vor BP" Width="170" SortMemberPath="Declared">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Declared}" Classes.total="{Binding Total}" Theme="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Umsatz nach BP" Width="170" SortMemberPath="Calculated">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Calculated}" Classes.total="{Binding Total}" Theme="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Differenz" Width="170" SortMemberPath="Difference">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Difference}" Classes.total="{Binding Total}" Theme="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Rohgewinnaufschlag" Theme="{StaticResource SectionHeader}"/>
                    <DataGrid x:Name="MarkupGrid" ui:Grids.Flex="0" Margin="0,0,0,24" Theme="{StaticResource Grid}" ItemsSource="{Binding Markups}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sparte" Width="220" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding Sparte}" Classes.total="{Binding Total}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Einsatz der Portionen" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding CostOfGoods}" Classes.total="{Binding Total}" Theme="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Umsatz (netto)" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding RevenueNet}" Classes.total="{Binding Total}" Theme="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Rohgewinn" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding GrossProfit}" Classes.total="{Binding Total}" Theme="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Aufschlagsatz" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding Markup}" Classes.total="{Binding Total}" Theme="{StaticResource Cell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Zusammenfassung" Theme="{StaticResource SectionHeader}"/>
                    <ItemsControl Margin="0,0,0,24" ItemsSource="{Binding Summary}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:KV">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Theme="{StaticResource KeyLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding HasYields}">
                        <TextBlock Text="Ertragsregeln" Theme="{StaticResource SectionHeader}"/>
                        <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Yields}" ItemTemplate="{StaticResource YieldGroupTemplate}" MaxWidth="960" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:Screen>
