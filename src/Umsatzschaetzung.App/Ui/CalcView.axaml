<ui:Screen x:Class="Umsatzschaetzung.App.Ui.CalcView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           xmlns:m="clr-namespace:Umsatzschaetzung.Model;assembly=Umsatzschaetzung.Core"
           x:DataType="ui:CalcModel"
           Margin="0,12,0,0">
    <ui:Screen.Styles>
        <Style Selector="DataGrid#ProductGrid DataGridRow" x:DataType="ui:ProductRowModel">
            <Setter Property="Opacity" Value="{Binding Fade}"/>
        </Style>
        <Style Selector="DataGrid#RevenueGrid DataGridRow">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="DataGrid#MarkupGrid DataGridRow">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.total">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ui:Screen.Styles>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Right" Text="Wird neu berechnet …" Theme="{StaticResource Muted}" Margin="0,0,0,16" IsVisible="{Binding Busy}"/>
        <Grid>
            <TextBlock Text="Wird berechnet …" Theme="{StaticResource EmptyState}" IsVisible="{Binding Calculating}"/>
            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding NoInvoices}">
                <TextBlock Text="Noch keine Datengrundlage" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Die Kalkulation leitet Portionen und Umsätze aus den zugeordneten Rechnungspositionen ab. Ohne Rechnungen gibt es nichts zu rechnen."/>
                <Button Content="Zu den Rechnungen" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="GoInvoices"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasResult}">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Produkte" Theme="{StaticResource SectionHeader}"/>
                    <StackPanel Margin="0,0,0,24">
                        <DataGrid x:Name="ProductGrid" ui:Grids.Flex="0" Theme="{StaticResource Grid}" ItemsSource="{Binding Products}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Produkt" Width="260" MinWidth="120" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Portionen" Width="130" SortMemberPath="Portions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <TextBlock Text="{Binding Portions}" Theme="{StaticResource Number}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Einsatz je Portion" Width="150" SortMemberPath="Cost">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <TextBlock Text="{Binding Cost}" Theme="{StaticResource Number}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bruttopreis" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Price, Mode=TwoWay}" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="USt" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <ComboBox ItemsSource="{Binding VatNames}" SelectedIndex="{Binding VatIndex, Mode=TwoWay}" Margin="2" HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Umsatz (netto)" Width="140" SortMemberPath="Revenue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <TextBlock Text="{Binding Revenue}" Theme="{StaticResource Number}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Aufschlagsatz" Width="140" SortMemberPath="Markup">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <TextBlock Text="{Binding Markup}" Theme="{StaticResource Number}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Aktiv" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <CheckBox IsChecked="{Binding Active, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:ProductRowModel">
                                            <Border Theme="{StaticResource BadgeWarning}" IsVisible="{Binding PriceMissing}">
                                                <TextBlock Text="Preis fehlt" Theme="{StaticResource BadgeText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander Header="Fixierte Portionen" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,120,220,90">
                                    <TextBlock Text="Produkt" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Column="1" Text="Portionen" Theme="{StaticResource FieldLabel}" Margin="8,0,0,4"/>
                                    <TextBlock Grid.Column="2" Text="Begründung" Theme="{StaticResource FieldLabel}" Margin="8,0,0,4"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Pinned}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:PinnedRow">
                                            <Grid Margin="0,0,0,6" ColumnDefinitions="*,120,220,90">
                                                <ComboBox ItemsSource="{Binding Options}" DisplayMemberBinding="{Binding Name, DataType=m:Product}" SelectedItem="{Binding Product, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                <TextBox Grid.Column="1" Theme="{StaticResource NumberBox}" Margin="8,0,0,0" Text="{Binding Portions, Mode=TwoWay}"/>
                                                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Reason, Mode=TwoWay}"/>
                                                <Button Grid.Column="3" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Entfernen" HorizontalAlignment="Right" Click="RemovePinned">
                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Produkt hinzufügen" Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="AddPinned"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <TextBlock Text="Umsätze vor und nach Betriebsprüfung" Theme="{StaticResource SectionHeader}"/>
                    <DataGrid x:Name="RevenueGrid" ui:Grids.Flex="0" Margin="0,0,0,24" Theme="{StaticResource Grid}" ItemsSource="{Binding Revenue}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Steuersatz" Width="220" MinWidth="120" SortMemberPath="Vat">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Vat}" Classes.total="{Binding Total}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Umsatz vor BP" Width="170" SortMemberPath="Declared">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Declared}" Classes.total="{Binding Total}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Umsatz nach BP" Width="170" SortMemberPath="Calculated">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Calculated}" Classes.total="{Binding Total}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Differenz" Width="170" SortMemberPath="Difference">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:RevenueRow">
                                        <TextBlock Text="{Binding Difference}" Classes.total="{Binding Total}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Rohgewinnaufschlag" Theme="{StaticResource SectionHeader}"/>
                    <DataGrid x:Name="MarkupGrid" ui:Grids.Flex="0" Theme="{StaticResource Grid}" ItemsSource="{Binding Markups}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sparte" Width="220" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding Sparte}" Classes.total="{Binding Total}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Einsatz der Portionen" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding CostOfGoods}" Classes.total="{Binding Total}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Umsatz (netto)" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding RevenueNet}" Classes.total="{Binding Total}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Rohgewinn" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding GrossProfit}" Classes.total="{Binding Total}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Aufschlagsatz" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:MarkupRow">
                                        <TextBlock Text="{Binding Markup}" Classes.total="{Binding Total}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding MarkupNote}" Theme="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/>

                    <TextBlock Text="Zusammenfassung" Theme="{StaticResource SectionHeader}"/>
                    <ItemsControl Margin="0,0,0,16" ItemsSource="{Binding Summary}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:KV">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Theme="{StaticResource KeyLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander Header="Rechenweg" Margin="0,0,0,16">
                        <Border Theme="{StaticResource Panel}" Margin="0,8,0,0" Padding="16">
                            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Zutaten" Theme="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding Ingredients}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:IngredientRow">
                                                <StackPanel Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name, StringFormat='{}{0}: verkaufsfähige Menge'}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.SellableNote}}" Theme="{StaticResource Muted}" TextWrapping="Wrap"
                                                                       IsVisible="{Binding ., Converter={x:Static ui:Fmt.HasYield}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding ., Converter={x:Static ui:Fmt.Sellable}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                    </Grid>
                                                    <StackPanel Margin="18,0,0,0">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel>
                                                                <TextBlock Text="Verbrauch"/>
                                                                <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.UsedNote}}" Theme="{StaticResource Muted}" TextWrapping="Wrap"
                                                                           IsVisible="{Binding ., Converter={x:Static ui:Fmt.HasStock}}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding ., Converter={x:Static ui:Fmt.Used}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                        </Grid>
                                                        <StackPanel Margin="18,0,0,0">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel>
                                                                    <TextBlock Text="Einkauf"/>
                                                                    <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.BoughtNote}}" Theme="{StaticResource Muted}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding ., Converter={x:Static ui:Fmt.Bought}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Purchases}" Margin="18,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="m:Purchase">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.Line}}" TextWrapping="Wrap"/>
                                                                                <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.QtyNote}}" Theme="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1" Text="{Binding ., Converter={x:Static ui:Fmt.Qty}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Umsatz" Theme="{StaticResource FieldLabel}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Kalkulierter Umsatz (netto)"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RevenueNet, Converter={x:Static ui:Fmt.Cents}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Sold}" Margin="18,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:ProductRow">
                                                <StackPanel Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.Sold}}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.SoldNote}}" Theme="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding RevenueNet, Converter={x:Static ui:Fmt.Cents}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                    </Grid>
                                                    <StackPanel Margin="18,0,0,0">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel>
                                                                <TextBlock Text="Portionen"/>
                                                                <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.PortionsNote}}" Theme="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Portions, Converter={x:Static ui:Fmt.Portions}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel>
                                                                <TextBlock Text="Preis (brutto)"/>
                                                                <TextBlock Text="{Binding ., Converter={x:Static ui:Fmt.PriceNote}}" Theme="{StaticResource Muted}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding GrossPrice, Converter={x:Static ui:Fmt.Cents}}" Theme="{StaticResource Number}" Margin="16,0,0,0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:Screen>
