<ui:Screen x:Class="Umsatzschaetzung.App.Ui.RulesView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           x:DataType="ui:RulesModel"
           Margin="24">
    <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Theme="{StaticResource HelpButton}" Click="ShowHelp"
                AutomationProperties.Name="Hilfe" AutomationProperties.AcceleratorKey="F1" AutomationProperties.AutomationId="RulesHelp"/>
        <TabControl x:Name="Tabs" Theme="{StaticResource KeptTabs}" Background="Transparent" BorderThickness="0" KeyboardNavigation.TabIndex="0"
                    AutomationProperties.Name="Regelbereiche" AutomationProperties.AutomationId="RulesTabs">

            <TabItem x:Name="ProductsTab" Header="Produkte" AutomationProperties.AutomationId="RulesProductsTab">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34*" MinWidth="240"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="66*" MinWidth="420"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="8" ColumnDefinitions="*,Auto">
                                <ui:SearchBox x:Name="ProductSearch" Width="NaN" AutomationProperties.Name="Produkte filtern" AutomationProperties.AutomationId="ProductSearch"/>
                                <Button x:Name="ProductNew" Grid.Column="1" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip.Tip="Neu" Click="NewProduct"
                                        AutomationProperties.Name="Neues Produkt" AutomationProperties.AutomationId="ProductNew">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <ListBox x:Name="ProductGrid" AutomationProperties.Name="Produkte" AutomationProperties.AutomationId="ProductList" SelectionChanged="ProductSelected" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:ProductItem">
                                            <StackPanel Margin="4,4" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Spoken}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" Theme="{StaticResource Muted}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCategory}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ui:NoResults Search="{Binding #ProductSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Spaltenbreite"/>
                    <Grid Grid.Column="2" DataContext="{Binding Products}" x:DataType="ui:ProductForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links ein Produkt auswählen, um es zu bearbeiten – oder mit „Neu“ ein neues anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
                                <Grid ColumnDefinitions="*,12,160">
                                    <StackPanel>
                                        <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ProductName" Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"
                                                 AutomationProperties.Name="Name des Produkts (Pflichtfeld)" AutomationProperties.AutomationId="ProductName"
                                                 AutomationProperties.HelpText="{Binding NameInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Der Name fehlt.'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Einheit" Theme="{StaticResource FieldLabel}"
                                                   ToolTip.Tip="Worin das Produkt gezählt wird: in Einkäufen, im Bestand und in Rezepten."/>
                                        <ComboBox x:Name="ProductUnit" ItemsSource="{Binding UnitNames}" SelectedIndex="{Binding UnitIndex, Mode=TwoWay}" IsEnabled="{Binding UnitFree}"
                                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Einheit" AutomationProperties.AutomationId="ProductUnit" ToolTip.ShowOnDisabled="True"
                                                  ToolTip.Tip="{Binding UnitLocked, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Fest, solange Rezepte oder Zuordnungen das Produkt verwenden.'}"
                                                  AutomationProperties.HelpText="{Binding UnitLocked, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Fest, solange Rezepte oder Zuordnungen das Produkt verwenden.'}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="Kategorie" Theme="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Category.Options}" SelectedItem="{Binding Category.Selected, Mode=TwoWay}"
                                              DisplayMemberBinding="{Binding Name, DataType=ui:CategoryOption}" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Kategorie" AutomationProperties.AutomationId="ProductCategory"/>
                                    <TextBox Text="{Binding Category.NewName, Mode=TwoWay}" PlaceholderText="Name der neuen Kategorie"
                                             IsVisible="{Binding Category.Creating}" Classes.invalid="{Binding Category.Invalid}" Margin="0,6,0,0"
                                             AutomationProperties.Name="Name der neuen Kategorie" AutomationProperties.AutomationId="ProductNewCategory"
                                             AutomationProperties.HelpText="{Binding Category.Invalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Der Name der neuen Kategorie fehlt.'}"/>
                                </StackPanel>
                                <StackPanel ToolTip.Tip="Warenarten, die unter diesem Produkt gebucht werden, eine je Zeile, etwa „Gouda“ oder „Emmentaler“ bei Schnittkäse.">
                                    <TextBlock Text="Warenarten" Theme="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Aliases, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="80" PlaceholderText="eine Warenart je Zeile"
                                             AutomationProperties.Name="Warenarten" AutomationProperties.AutomationId="ProductAliases"
                                             AutomationProperties.HelpText="Warenarten, die unter diesem Produkt gebucht werden, eine je Zeile, etwa „Gouda“ oder „Emmentaler“ bei Schnittkäse."/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Left"
                                            ToolTip.Tip="Rechnet Positionen in Stück ohne eigenen Faktor um, etwa 1 Gurke ≈ 400 g. Ein Richtwert — leer lassen, wenn es keinen gibt.">
                                    <TextBlock Text="Stückgewicht" Theme="{StaticResource FieldLabel}"/>
                                    <DockPanel Width="240">
                                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PieceUnitNames}" SelectedIndex="{Binding PieceUnitIndex, Mode=TwoWay}"
                                                  IsEnabled="{Binding PieceUnitFree}" Width="104" Margin="6,0,0,0"
                                                  AutomationProperties.Name="Einheit des Stückgewichts" AutomationProperties.AutomationId="ProductPieceUnit"/>
                                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Piece, Mode=TwoWay}" Classes.invalid="{Binding PieceInvalid}"
                                                 PlaceholderText="kein Richtwert" AutomationProperties.Name="Stückgewicht" AutomationProperties.AutomationId="ProductPiece"
                                                 AutomationProperties.HelpText="{Binding PieceInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Ungültig: eine ganze Zahl größer als 0 eingeben oder leer lassen.'}"/>
                                    </DockPanel>
                                </StackPanel>
                                <TextBlock Text="Rezept" Theme="{StaticResource SectionHeader}" Margin="0,20,0,4" AutomationProperties.HeadingLevel="3"/>
                                <TextBlock Text="{Binding Origin}" Theme="{StaticResource Muted}" Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"
                                           IsVisible="{Binding Origin, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="Ohne Rezept wird das Produkt eingekauft, nicht hergestellt." IsVisible="{Binding !HasRecipe}"
                                           Theme="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel IsVisible="{Binding HasRecipe}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                        <TextBlock Text="Das Rezept ergibt" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ProductBatch" Theme="{StaticResource NumberBox}" Text="{Binding Batch, Mode=TwoWay}" Classes.invalid="{Binding BatchInvalid}" Width="110"
                                                 AutomationProperties.Name="{Binding BatchUnit, StringFormat='Das Rezept ergibt, in {0}'}" AutomationProperties.AutomationId="ProductBatch"
                                                 AutomationProperties.HelpText="{Binding BatchInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Ungültig: eine ganze Zahl größer als 0 eingeben.'}"/>
                                        <TextBlock Text="{Binding BatchUnit}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Produkt" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Column="1" Text="Menge" Theme="{StaticResource FieldLabel}" Margin="8,0,0,4"/>
                                    </Grid>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Recipe}" AutomationProperties.Name="Rezeptzeilen" AutomationProperties.AutomationId="ProductRecipe">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:RecipeRow">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:ProductBox Choices="{Binding Options}" SelectedItem="{Binding Part, Mode=TwoWay}"
                                                               Classes.invalid="{Binding PartInvalid}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RecipePart"
                                                               AutomationProperties.HelpText="{Binding PartInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Ungültig: ein Produkt wählen.'}"/>
                                                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Units}" SelectedIndex="{Binding UnitIndex, Mode=TwoWay}" Classes.invalid="{Binding UnitMismatch}" ToolTip.Tip="{Binding UnitHint}" AutomationProperties.HelpText="{Binding UnitHint}"
                                                              Width="120" Margin="6,0,0,0" AutomationProperties.Name="{Binding Title, StringFormat='Einheit {0}'}" AutomationProperties.AutomationId="RecipeUnit"/>
                                                    <TextBox x:Name="RecipeAmount" Theme="{StaticResource NumberBox}" Text="{Binding Amount, Mode=TwoWay}"
                                                             Classes.invalid="{Binding AmountInvalid}" AutomationProperties.Name="{Binding Title, StringFormat='Menge {0}'}" AutomationProperties.AutomationId="RecipeAmount"
                                                             AutomationProperties.HelpText="{Binding AmountInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Ungültig: eine ganze Zahl größer als 0 eingeben.'}"/>
                                                </DockPanel>
                                                <Button Grid.Column="2" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Entfernen" HorizontalAlignment="Right" Click="RemoveRecipeLine"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='{}{0} entfernen'}" AutomationProperties.AutomationId="RecipeRemove">
                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Theme="{StaticResource SecondaryButton}" ToolTip.Tip="Rezeptzeile hinzufügen" HorizontalAlignment="Left" Click="AddRecipeLine"
                                        AutomationProperties.Name="Rezeptzeile hinzufügen" AutomationProperties.AutomationId="RecipeAdd">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Theme="{StaticResource PrimaryButton}" MinWidth="0" Margin="0,0,8,0" ToolTip.Tip="Speichern" Click="SaveProduct"
                                            AutomationProperties.Name="Produkt speichern" AutomationProperties.AutomationId="ProductSave">
                                        <PathIcon Data="{StaticResource SaveIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                    </Button>
                                    <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteProduct" IsVisible="{Binding Existing}"
                                            AutomationProperties.Name="Produkt löschen" AutomationProperties.AutomationId="ProductDelete">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="YieldsTab" Header="Ertragsregeln" AutomationProperties.AutomationId="RulesYieldsTab">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34*" MinWidth="220"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="66*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <ui:SearchBox x:Name="YieldSearch" DockPanel.Dock="Top" Width="NaN" Margin="8" AutomationProperties.Name="Kategorien und Produkte filtern" AutomationProperties.AutomationId="YieldSearch"/>
                            <Grid>
                                <ListBox x:Name="ScopeGrid" AutomationProperties.Name="Kategorien und Produkte" AutomationProperties.AutomationId="ScopeList" SelectionChanged="ScopeSelected" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:ScopeItem">
                                            <Grid ColumnDefinitions="*,Auto" Margin="4,6" AutomationProperties.Name="{Binding Spoken}">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Hint}" Theme="{StaticResource Muted}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ui:NoResults Search="{Binding #YieldSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Spaltenbreite"/>
                    <Grid Grid.Column="2" DataContext="{Binding Yields}" x:DataType="ui:YieldForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Kategorie oder ein Produkt auswählen, um die Ertragsregeln zu bearbeiten."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
                                <Grid ColumnDefinitions="*,12,96,24,80,40" Margin="0,0,0,4">
                                    <TextBlock Text="Name" Theme="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="2" Text="Abzug" Theme="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="4" Text="Standard" Theme="{StaticResource FieldLabel}" HorizontalAlignment="Center" ToolTip.Tip="Die Standardregel gilt, solange die Prüfung unter Kalkulation › Ertragsregeln nichts anderes wählt. Ohne Standardregel wird nichts abgezogen."/>
                                </Grid>
                                <ItemsControl x:Name="RuleList" ItemsSource="{Binding Rules}" AutomationProperties.Name="Ertragsregeln" AutomationProperties.AutomationId="YieldRules">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:YieldRow">
                                            <Grid ColumnDefinitions="*,12,96,24,80,40" Margin="0,0,0,6">
                                                <TextBox x:Name="RuleName" Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"
                                                         PlaceholderText="{Binding Placeholder}" LostFocus="YieldRowLeft"
                                                         AutomationProperties.Name="Name der Regel" AutomationProperties.AutomationId="YieldName"
                                                         AutomationProperties.HelpText="{Binding NameInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Der Name fehlt.'}"/>
                                                <TextBox x:Name="RuleDeduction" Grid.Column="2" Theme="{StaticResource NumberBox}" Text="{Binding Deduction, Mode=TwoWay}"
                                                         Classes.invalid="{Binding DeductionInvalid}" LostFocus="YieldRowLeft"
                                                         AutomationProperties.Name="Abzug in Prozent" AutomationProperties.AutomationId="YieldDeduction"
                                                         AutomationProperties.HelpText="{Binding DeductionInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Ungültig: einen Abzug von 0 bis 100 % eingeben.'}"/>
                                                <TextBlock Grid.Column="3" Text="%" Theme="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                                                <CheckBox Grid.Column="4" IsChecked="{Binding IsDefault}" HorizontalAlignment="Center"
                                                          ToolTip.Tip="Die Standardregel gilt, solange die Prüfung unter Kalkulation › Ertragsregeln nichts anderes wählt. Ohne Standardregel wird nichts abgezogen."
                                                          AutomationProperties.Name="Standardregel" AutomationProperties.AutomationId="YieldDefault"/>
                                                <Button Grid.Column="5" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteYield"
                                                        IsVisible="{Binding Existing}" HorizontalAlignment="Right"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Regel „{0}“ löschen'}" AutomationProperties.AutomationId="YieldDelete">
                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="GewerbeTab" Header="Gewerbe" AutomationProperties.AutomationId="RulesGewerbeTab">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="62*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="8" ColumnDefinitions="*,Auto">
                                <ui:SearchBox x:Name="GewerbeSearch" Width="NaN" AutomationProperties.Name="Gewerbekennzahlen filtern" AutomationProperties.AutomationId="GewerbeSearch"/>
                                <Button x:Name="GewerbeNew" Grid.Column="1" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip.Tip="Neu" Click="NewGewerbe"
                                        AutomationProperties.Name="Neue Gewerbekennzahl" AutomationProperties.AutomationId="GewerbeNew">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <ListBox x:Name="GewerbeGrid" AutomationProperties.Name="Gewerbekennzahlen" AutomationProperties.AutomationId="GewerbeList" SelectionChanged="GewerbeSelected" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:GewerbeItem">
                                            <Grid ColumnDefinitions="64,*" Margin="4,6" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Search}">
                                                <TextBlock Text="{Binding Kennzahl}" Theme="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ui:NoResults Search="{Binding #GewerbeSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Spaltenbreite"/>
                    <Grid Grid.Column="2" DataContext="{Binding Gewerbe}" x:DataType="ui:GewerbeForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Gewerbekennzahl auswählen, um sie zu bearbeiten – oder mit „Neu“ eine neue anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
                                <StackPanel HorizontalAlignment="Left" ToolTip.Tip="Die Kennzahlen stehen in der Prüfung zur Wahl. Kategorien grenzen ihre Produkte über den Anfang der Kennzahl ein, etwa „561“ für alle Gaststätten.">
                                    <TextBlock Text="Kennzahl *" Theme="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GewerbeKennzahl" Text="{Binding Kennzahl, Mode=TwoWay}" Classes.invalid="{Binding KennzahlInvalid}"
                                             Width="160" HorizontalAlignment="Left" PlaceholderText="z. B. 56101.0"
                                             AutomationProperties.Name="Kennzahl (Pflichtfeld)" AutomationProperties.AutomationId="GewerbeKennzahl"
                                             AutomationProperties.HelpText="{Binding KennzahlInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Ungültig oder schon vergeben: eine Kennzahl wie 56101.0 eingeben.'}"/>
                                </StackPanel>
                                <TextBlock Text="Bezeichnung *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GewerbeName" Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"
                                         AutomationProperties.Name="Bezeichnung (Pflichtfeld)" AutomationProperties.AutomationId="GewerbeName"
                                         AutomationProperties.HelpText="{Binding NameInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Die Bezeichnung fehlt.'}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteGewerbe" IsVisible="{Binding Existing}"
                                            AutomationProperties.Name="Gewerbekennzahl löschen" AutomationProperties.AutomationId="GewerbeDelete">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TemplatesTab" Header="Vorlagen" AutomationProperties.AutomationId="RulesTemplatesTab">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*" MinWidth="220"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="70*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button x:Name="TemplateNew" DockPanel.Dock="Right" Theme="{StaticResource SecondaryButton}" ToolTip.Tip="Neu" Click="NewTemplate"
                                        AutomationProperties.Name="Neue Vorlage" AutomationProperties.AutomationId="TemplateNew">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                                <TextBlock/>
                            </DockPanel>
                            <ListBox x:Name="TemplateGrid" AutomationProperties.Name="Vorlagen" AutomationProperties.AutomationId="TemplateList" SelectionChanged="TemplateSelected" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="ui:TemplateItem">
                                        <TextBlock Text="{Binding Label}" Margin="4,6" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Spaltenbreite"/>
                    <Grid Grid.Column="2" DataContext="{Binding Templates}" x:DataType="ui:TemplateForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Vorlage auswählen, um sie zu bearbeiten – oder mit „Neu“ eine Kopie der Standardvorlage anlegen."/>
                        <DockPanel Margin="8,0,16,16" IsVisible="{Binding Active}">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
                                <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TemplateName" Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"
                                         AutomationProperties.Name="Name der Vorlage (Pflichtfeld)" AutomationProperties.AutomationId="TemplateName"
                                         AutomationProperties.HelpText="{Binding NameInvalid, Converter={x:Static ui:RulesView.Flag}, ConverterParameter='Der Name fehlt.'}"/>
                                <CheckBox Content="Standard" IsChecked="{Binding IsDefault, Mode=TwoWay}" Margin="0,8,0,0"
                                          AutomationProperties.Name="Standardvorlage" AutomationProperties.AutomationId="TemplateDefault"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Theme="{StaticResource PrimaryButton}" MinWidth="0" Margin="0,0,8,0" ToolTip.Tip="Speichern" Click="SaveTemplate"
                                        AutomationProperties.Name="Vorlage speichern" AutomationProperties.AutomationId="TemplateSave">
                                    <PathIcon Data="{StaticResource SaveIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                                <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteTemplate" IsVisible="{Binding Existing}"
                                        AutomationProperties.Name="Vorlage löschen" AutomationProperties.AutomationId="TemplateDelete">
                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" AutomationProperties.AccessibilityView="Raw"/>
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Vorlage" Theme="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TemplateSource" Text="{Binding Source, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True"
                                     AutomationProperties.Name="Vorlage" AutomationProperties.AutomationId="TemplateSource"
                                     AutomationProperties.HelpText="Die Tabulatortaste rückt ein, Strg+Tabulator verlässt das Feld."
                                     TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:Screen>
