<ui:Screen x:Class="Umsatzschaetzung.App.Ui.RulesView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           xmlns:m="clr-namespace:Umsatzschaetzung.Model;assembly=Umsatzschaetzung.Core"
           x:DataType="ui:RulesModel"
           Margin="24">
    <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Theme="{StaticResource HelpButton}" Click="ShowHelp"/>
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">

            <TabItem Header="Zutaten">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="62*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip.Tip="Neu" Click="NewIngredient">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14"/>
                                </Button>
                                <ui:SearchBox x:Name="IngredientSearch" Width="NaN"/>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="IngredientGrid" SelectionChanged="IngredientSelected" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:IngredientItem">
                                            <Grid ColumnDefinitions="*,Auto" Margin="4,6" ToolTip.Tip="{Binding Tip}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AliasCount}" Theme="{StaticResource Muted}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ui:NoResults Search="{Binding #IngredientSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Ingredients}" x:DataType="ui:IngredientForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Zutat auswählen, um sie zu bearbeiten – oder mit „Neu“ eine neue anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"/>
                                <StackPanel>
                                    <TextBlock Text="Warenarten" Theme="{StaticResource FieldLabel}"
                                               ToolTip.Tip="Warenarten, die unter dieser Zutat gebucht werden — eine je Zeile."/>
                                    <TextBox Text="{Binding Aliases, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="110" PlaceholderText="eine Warenart je Zeile"/>
                                    <TextBlock Text="Je Zeile eine Warenart, etwa „Gouda“ oder „Emmentaler“ bei Schnittkäse."
                                               Theme="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Stückgewicht" Theme="{StaticResource FieldLabel}"
                                               ToolTip.Tip="Ungefähres Gewicht oder Volumen eines Stücks."/>
                                    <DockPanel HorizontalAlignment="Left" Width="240">
                                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PieceUnitNames}" SelectedIndex="{Binding PieceUnitIndex, Mode=TwoWay}"
                                                  IsEnabled="{Binding PieceUnitFree}" Width="104" Margin="6,0,0,0"/>
                                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Piece, Mode=TwoWay}" Classes.invalid="{Binding PieceInvalid}"
                                                 PlaceholderText="kein Richtwert"/>
                                    </DockPanel>
                                    <TextBlock Text="Rechnet Positionen in Stück ohne eigenen Faktor um, etwa 1 Gurke ≈ 400 g. Ein Richtwert — leer lassen, wenn es keinen gibt."
                                               Theme="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Kategorie" Theme="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Category.Options}" SelectedItem="{Binding Category.Selected, Mode=TwoWay}"
                                              DisplayMemberBinding="{Binding Name, DataType=ui:CategoryOption}" HorizontalAlignment="Stretch"/>
                                    <TextBox Text="{Binding Category.NewName, Mode=TwoWay}" PlaceholderText="Name der neuen Kategorie"
                                             IsVisible="{Binding Category.Creating}" Classes.invalid="{Binding Category.Invalid}" Margin="0,6,0,0"
                                             LostFocus="CategoryNamed" KeyDown="CategoryNameKey"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteIngredient" IsVisible="{Binding Existing}">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Produkte">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="62*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip.Tip="Neu" Click="NewProduct">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14"/>
                                </Button>
                                <ui:SearchBox x:Name="ProductSearch" Width="NaN"/>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="ProductGrid" SelectionChanged="ProductSelected" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:ProductItem">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}" Margin="4,6"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ui:NoResults Search="{Binding #ProductSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Products}" x:DataType="ui:ProductForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links ein Produkt auswählen, um es zu bearbeiten – oder mit „Neu“ ein neues anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"/>
                                <TextBlock Text="Rezept *" Theme="{StaticResource SectionHeader}" Margin="0,20,0,4"/>
                                <TextBlock Text="{Binding Origin}" Theme="{StaticResource Muted}" Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,8"
                                           IsVisible="{Binding Origin, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zutat oder Produkt" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Column="1" Text="Menge je Portion" Theme="{StaticResource FieldLabel}" Margin="8,0,48,4"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Recipe}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:RecipeRow">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel>
                                                    <ComboBox DockPanel.Dock="Left" ItemsSource="{x:Static ui:RecipeRow.Kinds}" SelectedIndex="{Binding KindIndex, Mode=TwoWay}"
                                                              Width="104" Margin="0,0,6,0"/>
                                                    <ui:IngredientBox Choices="{Binding Options}" SelectedItem="{Binding Ingredient, Mode=TwoWay}" IsVisible="{Binding IsIngredient}"
                                                                      Classes.invalid="{Binding IngredientInvalid}" HorizontalAlignment="Stretch"/>
                                                    <AutoCompleteBox ItemsSource="{Binding Products}" SelectedItem="{Binding Part, Mode=TwoWay}" IsVisible="{Binding IsPart}"
                                                                     FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="320" PlaceholderText="Produkt suchen …"
                                                                     ValueMemberBinding="{ReflectionBinding Name}" Classes.invalid="{Binding IngredientInvalid}" HorizontalAlignment="Stretch">
                                                        <AutoCompleteBox.ItemTemplate>
                                                            <DataTemplate x:DataType="m:Product">
                                                                <TextBlock Text="{Binding Name}"/>
                                                            </DataTemplate>
                                                        </AutoCompleteBox.ItemTemplate>
                                                    </AutoCompleteBox>
                                                </DockPanel>
                                                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Units}" SelectedIndex="{Binding UnitIndex, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsIngredient}" Width="104" Margin="6,0,0,0"/>
                                                    <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Amount, Mode=TwoWay}"
                                                             Classes.invalid="{Binding AmountInvalid}"/>
                                                </DockPanel>
                                                <Button Grid.Column="2" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Entfernen" HorizontalAlignment="Right" Click="RemoveRecipeLine">
                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Theme="{StaticResource SecondaryButton}" ToolTip.Tip="Zutat hinzufügen" HorizontalAlignment="Left" Click="AddRecipeLine">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Theme="{StaticResource PrimaryButton}" MinWidth="0" Margin="0,0,8,0" ToolTip.Tip="Speichern" Click="SaveProduct">
                                        <PathIcon Data="{StaticResource SaveIcon}" Width="14" Height="14"/>
                                    </Button>
                                    <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteProduct" IsVisible="{Binding Existing}">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Ertragsregeln">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34*" MinWidth="220"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="66*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <ui:SearchBox x:Name="YieldSearch" DockPanel.Dock="Top" Width="NaN" Margin="8"/>
                            <Grid>
                                <ListBox x:Name="ScopeGrid" SelectionChanged="ScopeSelected" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:ScopeItem">
                                            <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Hint}" Theme="{StaticResource Muted}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ui:NoResults Search="{Binding #YieldSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Yields}" x:DataType="ui:YieldForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Kategorie oder Zutat auswählen, um ihre Ertragsregeln zu bearbeiten."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,12,96,24,80,40" Margin="0,0,0,4">
                                    <TextBlock Text="Name" Theme="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="2" Text="Abzug" Theme="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="4" Text="Standard" Theme="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="RuleList" ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:YieldRow">
                                            <Grid ColumnDefinitions="*,12,96,24,80,40" Margin="0,0,0,6">
                                                <TextBox x:Name="RuleName" Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"
                                                         PlaceholderText="{Binding Placeholder}" LostFocus="YieldRowLeft"/>
                                                <TextBox x:Name="RuleDeduction" Grid.Column="2" Theme="{StaticResource NumberBox}" Text="{Binding Deduction, Mode=TwoWay}"
                                                         Classes.invalid="{Binding DeductionInvalid}" LostFocus="YieldRowLeft"/>
                                                <TextBlock Grid.Column="3" Text="%" Theme="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="4" IsChecked="{Binding IsDefault}" HorizontalAlignment="Center"
                                                          ToolTip.Tip="Gilt, solange die Prüfung nichts anderes wählt"/>
                                                <Button Grid.Column="5" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteYield"
                                                        IsVisible="{Binding Existing}" HorizontalAlignment="Right">
                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Die Standardregel gilt, solange die Prüfung unter Kalkulation › Ertragsregeln nichts anderes wählt. Ohne Standardregel wird nichts abgezogen."
                                           Theme="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Gewerbe">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="62*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip.Tip="Neu" Click="NewGewerbe">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14"/>
                                </Button>
                                <ui:SearchBox x:Name="GewerbeSearch" Width="NaN"/>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="GewerbeGrid" SelectionChanged="GewerbeSelected" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="ui:GewerbeItem">
                                            <Grid ColumnDefinitions="64,*" Margin="4,6" ToolTip.Tip="{Binding Name}">
                                                <TextBlock Text="{Binding Kennzahl}" Theme="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ui:NoResults Search="{Binding #GewerbeSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Gewerbe}" x:DataType="ui:GewerbeForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Gewerbekennzahl auswählen, um sie zu bearbeiten – oder mit „Neu“ eine neue anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <TextBlock Text="Kennzahl *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GewerbeKennzahl" Text="{Binding Kennzahl, Mode=TwoWay}" Classes.invalid="{Binding KennzahlInvalid}"
                                         Width="160" HorizontalAlignment="Left" PlaceholderText="z. B. 56101.0"/>
                                <TextBlock Text="Bezeichnung *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GewerbeName" Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"/>
                                <TextBlock Text="Die Kennzahlen stehen in der Prüfung zur Wahl. Kategorien grenzen ihre Zutaten über den Anfang der Kennzahl ein, etwa „561“ für alle Gaststätten."
                                           Theme="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteGewerbe" IsVisible="{Binding Existing}">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Vorlagen">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*" MinWidth="220"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="70*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource SecondaryButton}" ToolTip.Tip="Neu" Click="NewTemplate">
                                    <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14"/>
                                </Button>
                                <TextBlock/>
                            </DockPanel>
                            <ListBox x:Name="TemplateGrid" SelectionChanged="TemplateSelected" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="ui:TemplateItem">
                                        <TextBlock Text="{Binding Label}" Margin="4,6" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Templates}" x:DataType="ui:TemplateForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Vorlage auswählen, um sie zu bearbeiten – oder mit „Neu“ eine Kopie der Standardvorlage anlegen."/>
                        <DockPanel Margin="8,0,16,16" IsVisible="{Binding Active}">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TemplateName" Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"/>
                                <CheckBox Content="Standard" IsChecked="{Binding IsDefault, Mode=TwoWay}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Theme="{StaticResource PrimaryButton}" MinWidth="0" Margin="0,0,8,0" ToolTip.Tip="Speichern" Click="SaveTemplate">
                                    <PathIcon Data="{StaticResource SaveIcon}" Width="14" Height="14"/>
                                </Button>
                                <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="DeleteTemplate" IsVisible="{Binding Existing}">
                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Vorlage" Theme="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TemplateSource" Text="{Binding Source, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:Screen>
