<UserControl x:Class="Umsatzschaetzung.App.Ui.InvoicePane"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Theme="{StaticResource ErrorBanner}" IsVisible="False">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Theme="{StaticResource ErrorBannerClose}" Click="DismissError"/>
                <TextBlock x:Name="ErrorText" Theme="{StaticResource ErrorBannerText}"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="Body" Margin="16"/>
    </DockPanel>
</UserControl>
