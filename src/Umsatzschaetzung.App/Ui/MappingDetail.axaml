<UserControl x:Class="Umsatzschaetzung.App.Ui.MappingDetail"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
             x:DataType="ui:MappingDetailModel">
    <UserControl.Styles>
        <Style Selector="DataGridRow TextBlock.cell">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.source">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Border.source.invoice">
            <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}"/>
        </Style>
        <Style Selector="Border.source.rules">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoSoftBrush}"/>
        </Style>
        <Style Selector="StackPanel.origin">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="StackPanel.origin > PathIcon">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="StackPanel.origin > TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.invoice StackPanel.origin">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Style>
        <Style Selector="Border.rules StackPanel.origin">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoBrush}"/>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Top" Theme="{StaticResource BadgeSuccess}" HorizontalAlignment="Left"
                Margin="0,0,0,12" IsVisible="{Binding HasAssigned}">
            <TextBlock Text="{Binding Assigned}" Theme="{StaticResource BadgeText}" TextWrapping="Wrap"/>
        </Border>
        <Grid>
        <TextBlock Text="Keine Position gewählt" Theme="{StaticResource EmptyState}" IsVisible="{Binding NoSelection}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
            <StackPanel Margin="0,0,14,0">
                <Border Classes="source invoice">
                    <StackPanel>
                        <StackPanel Classes="origin">
                            <PathIcon Data="{StaticResource DocumentIcon}"/>
                            <TextBlock Text="AUS DER RECHNUNG"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Text="Lieferant" Theme="{StaticResource KeyLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Supplier}" Theme="{StaticResource KeyValue}"/>
                            <TextBlock Grid.Row="1" Text="Artikel" Theme="{StaticResource KeyLabel}" IsVisible="{Binding HasArticle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Article}" Theme="{StaticResource KeyValue}" FontFamily="{StaticResource MonoFont}" IsVisible="{Binding HasArticle}"/>
                            <TextBlock Grid.Row="2" Text="Menge" Theme="{StaticResource KeyLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Total}" Theme="{StaticResource KeyValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="source rules">
                    <StackPanel>
                        <StackPanel Classes="origin">
                            <PathIcon Data="{StaticResource RulesIcon}"/>
                            <TextBlock Text="AUS DEN REGELN"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*" IsVisible="{Binding HasCurrent}">
                            <TextBlock Text="Zugeordnet" Theme="{StaticResource KeyLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Current}" Theme="{StaticResource KeyValue}"/>
                        </Grid>
                        <StackPanel IsVisible="{Binding ShowCandidates}">
                            <TextBlock Text="Vorschläge werden ermittelt …" Theme="{StaticResource Muted}" IsVisible="{Binding Loading}"/>
                            <TextBlock Text="Keine Vorschläge — bitte manuell zuordnen." Theme="{StaticResource Muted}" IsVisible="{Binding NoCandidates}"/>
                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:CandidateRow">
                                        <RadioButton GroupName="Candidates" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Theme="{StaticResource BadgeSuccess}" IsVisible="{Binding IsExact}">
                                                        <TextBlock Text="{Binding ExactText}" Theme="{StaticResource BadgeText}"/>
                                                    </Border>
                                                    <Border Theme="{StaticResource BadgeInfo}" IsVisible="{Binding IsSuggested}">
                                                        <TextBlock Text="Vorschlag" Theme="{StaticResource BadgeText}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Confidence}" Theme="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <Border Theme="{StaticResource Badge}" Margin="8,0,0,0" IsVisible="{Binding InRecipe}" ToolTip.Tip="{Binding UsedIn}">
                                                        <TextBlock Text="In Rezeptur" Theme="{StaticResource BadgeText}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding ShowFields}" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="*,16,200">
                                <StackPanel IsVisible="{Binding Manual}">
                                    <TextBlock Text="Zutat *" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ui:IngredientBox Choices="{Binding Ingredients}" SelectedItem="{Binding Ingredient, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" IsVisible="{Binding ShowFactor}">
                                    <TextBlock Text="{Binding FactorLabel}" ToolTip.Tip="Inhalt eines Gebindes in der Rezepteinheit."
                                               Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="FactorBox" Theme="{StaticResource NumberBox}" Text="{Binding Factor, Mode=TwoWay}">
                                        <TextBox.InnerRightContent>
                                            <TextBlock Text="{Binding FactorUnit}" Theme="{StaticResource Muted}" FontSize="12" Margin="0,0,8,0"/>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding FactorHint}" Theme="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                       HorizontalAlignment="Right" TextAlignment="Right" IsVisible="{Binding ShowFactor}"/>
                            <DockPanel HorizontalAlignment="Right" Margin="0,4,0,0" IsVisible="{Binding HasOrigin}">
                                <PathIcon DockPanel.Dock="Left" Data="{StaticResource WarningIcon}" Foreground="{DynamicResource WarningBrush}"
                                          Width="12" Height="12" Margin="0,2,6,0" VerticalAlignment="Top" IsVisible="{Binding Estimate}"/>
                                <TextBlock Text="{Binding FactorOrigin}" Theme="{StaticResource Muted}" FontSize="12"
                                           TextAlignment="Right" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{Binding AssignLabel}" Theme="{StaticResource PrimaryButton}" IsEnabled="{Binding CanAssign}" Click="Assign" Margin="0,0,8,0"/>
                            <Button Content="{Binding ManualLabel}" Theme="{StaticResource SecondaryButton}" Click="ToggleManual"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="source invoice" IsVisible="{Binding HasSnippets}">
                    <StackPanel>
                        <StackPanel Classes="origin">
                            <PathIcon Data="{StaticResource DocumentIcon}"/>
                            <TextBlock Text="{Binding SnippetsTitle}"/>
                        </StackPanel>
                        <DataGrid ui:Grids.Flex="2" Theme="{StaticResource Grid}" ItemsSource="{Binding Snippets}" IsReadOnly="True"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Rechnung" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:SnippetRow">
                                            <TextBlock Classes="cell" Text="{Binding Number}" ToolTip.Tip="{Binding Number}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Datum" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:SnippetRow">
                                            <TextBlock Classes="cell" Text="{Binding Date}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Auszug" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:SnippetRow">
                                            <Panel Margin="4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding Loading}">
                                                    <PathIcon Theme="{StaticResource Spinner}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Auszug wird geladen …" Theme="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Kein Auszug verfügbar" Theme="{StaticResource Muted}" VerticalAlignment="Center" IsVisible="{Binding Missing}"/>
                                                <Image Source="{Binding Scan}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" IsVisible="{Binding HasScan}"/>
                                                <SelectableTextBlock Text="{Binding Excerpt}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasExcerpt}"/>
                                            </Panel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="ui:SnippetRow">
                                            <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Rechnung öffnen" Click="OpenInvoice" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource OpenIcon}" Width="14" Height="14"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
