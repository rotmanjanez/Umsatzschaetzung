<Window x:Class="Umsatzschaetzung.App.Ui.RulesWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Regeln" Width="1100" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Theme="{StaticResource ErrorBanner}" IsVisible="False">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Theme="{StaticResource ErrorBannerClose}" Click="DismissError"/>
                <TextBlock x:Name="ErrorText" Theme="{StaticResource ErrorBannerText}"/>
            </DockPanel>
        </Border>
        <Panel>
            <ContentControl x:Name="Body"/>
            <Border x:Name="SaveBadge" Theme="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,72,0" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Theme="{StaticResource Spinner}" Width="12" Height="12"/>
                    <TextBlock x:Name="SaveText" Theme="{StaticResource BadgeText}"/>
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>
</Window>
