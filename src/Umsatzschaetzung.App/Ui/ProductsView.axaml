<ui:Screen x:Class="Umsatzschaetzung.App.Ui.ProductsView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           xmlns:m="clr-namespace:Umsatzschaetzung.Model;assembly=Umsatzschaetzung.Core"
           x:DataType="ui:ProductsModel"
           Margin="0,12,0,0">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
                <TextBlock Text="Sortiment" Theme="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" AutomationProperties.HeadingLevel="2"/>
                <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" ToolTip.Tip="CSV importieren" Margin="0,0,8,0" Click="ImportCsv"
                        AutomationProperties.Name="CSV importieren" AutomationProperties.AutomationId="ProductsImportCsv">
                    <PathIcon Data="{StaticResource ImportIcon}" Width="14" Height="14"/>
                </Button>
                <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" ToolTip.Tip="CSV exportieren" Margin="0,0,8,0" IsEnabled="{Binding !EmptyAssortment}" Click="ExportCsv"
                        AutomationProperties.Name="CSV exportieren" AutomationProperties.AutomationId="ProductsExportCsv">
                    <PathIcon Data="{StaticResource ExportIcon}" Width="14" Height="14"/>
                </Button>
                <AutoCompleteBox x:Name="CatalogBox" Grid.Column="3" Width="300" PlaceholderText="Produkt hinzufügen …"
                                 FilterMode="None" MinimumPrefixLength="1" MaxDropDownHeight="320"
                                 ValueMemberBinding="{ReflectionBinding Name}" SelectionChanged="CatalogSelected" DropDownClosed="CatalogPicked"
                                 AutomationProperties.Name="Produkt hinzufügen" AutomationProperties.AutomationId="ProductsAdd"
                                 AutomationProperties.HelpText="Produkt aus dem Katalog suchen oder neu erstellen">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate x:DataType="m:Product">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                    <DataTemplate x:DataType="ui:ProductDraft">
                                        <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding Name}">
                                            <Border Background="{DynamicResource AccentButtonBackground}" Width="18" Height="18" CornerRadius="9"
                                                    AutomationProperties.AccessibilityView="Raw">
                                                <Path Data="{StaticResource NewIcon}" Fill="{DynamicResource AccentButtonForeground}"
                                                      Stretch="Uniform" Width="9" Height="9"/>
                                            </Border>
                                            <TextBlock Foreground="{DynamicResource AccentButtonBackground}" VerticalAlignment="Center">
                                                <Run Text="„"/><Run Text="{Binding Typed}" FontWeight="SemiBold"/><Run Text="“ neu erstellen"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
            </Grid>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Theme="{StaticResource Muted}" TextWrapping="Wrap" IsVisible="{Binding EmptyAssortment}"
                           Text="Noch keine Produkte im Sortiment."/>
                <DataGrid x:Name="ProductGrid" ui:Grids.Flex="0" Theme="{StaticResource Grid}" ItemsSource="{Binding Rows}" IsVisible="{Binding !EmptyAssortment}"
                          MaxHeight="{Binding #Scroller.Viewport.Height}"
                          KeyDown="ProductKey" PreparingCellForEdit="EditStarted"
                          AutomationProperties.Name="Sortiment" AutomationProperties.HelpText="F2 bearbeitet die Zelle, Entf nimmt das gewählte Produkt aus dem Sortiment" AutomationProperties.AutomationId="ProductsGrid">
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow" x:DataType="ui:AssortmentRow">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Produkt" Width="320" MinWidth="120" SortMemberPath="Name" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:AssortmentRow">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Bruttopreis" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:AssortmentRow">
                                    <TextBlock Text="{Binding Price}" Theme="{StaticResource Cell}" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:AssortmentRow">
                                    <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Price, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Name, StringFormat='Bruttopreis {0}'}" AutomationProperties.AutomationId="ProductPrice"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="USt" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:AssortmentRow">
                                    <TextBlock Text="{Binding Vat}" Theme="{StaticResource Cell}" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:AssortmentRow">
                                    <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Vat, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Name, StringFormat='Umsatzsteuer {0}'}" AutomationProperties.HelpText="19, 7 oder 0" AutomationProperties.AutomationId="ProductVat"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="230" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <Panel AutomationProperties.Name="Hinweise"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:AssortmentRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" AutomationProperties.Name="{Binding Notes}">
                                        <Border Theme="{StaticResource BadgeWarning}" IsVisible="{Binding PriceMissing}">
                                            <TextBlock Text="Preis fehlt" Theme="{StaticResource BadgeText}"/>
                                        </Border>
                                        <Button IsTabStop="False" Theme="{StaticResource LinkButton}" Padding="0" Cursor="Hand" IsVisible="{Binding Adjusted}"
                                                ToolTip.Tip="Eigene Rezeptur in dieser Prüfung. Öffnet die Kalkulation." Click="ShowRecipe"
                                                AutomationProperties.Name="Rezept angepasst" AutomationProperties.AutomationId="ProductRecipe">
                                            <Border Theme="{StaticResource BadgeInfo}">
                                                <TextBlock Text="Rezept angepasst" Theme="{StaticResource BadgeText}"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <Panel AutomationProperties.Name="Entfernen"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:AssortmentRow">
                                    <Button IsTabStop="False" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Aus dem Sortiment nehmen" HorizontalAlignment="Center" Click="RemoveFromAssortment"
                                            AutomationProperties.Name="{Binding Name, StringFormat='{}{0} aus dem Sortiment nehmen'}" AutomationProperties.AutomationId="ProductRemove">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <TextBlock Text="Vorschläge" Theme="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="2"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Vorschläge werden berechnet …" Theme="{StaticResource Muted}" IsVisible="{Binding Suggesting}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="Keine Vorschläge." Theme="{StaticResource Muted}" IsVisible="{Binding NoSuggestions}" AutomationProperties.LiveSetting="Polite"/>
                <ItemsControl ItemsSource="{Binding Suggestions}" AutomationProperties.Name="Vorschläge" AutomationProperties.AutomationId="ProductSuggestions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:SuggestionRow">
                            <Border Theme="{StaticResource Card}" Margin="0,0,0,6" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" ToolTip.Tip="Ins Sortiment" Margin="16,0,8,0" Click="AcceptSuggestion"
                                            AutomationProperties.Name="{Binding Name, StringFormat='{}{0} ins Sortiment'}" AutomationProperties.AutomationId="SuggestionAccept">
                                        <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14"/>
                                    </Button>
                                    <Button Grid.Column="2" Theme="{StaticResource IconButton}" ToolTip.Tip="Führt der Betrieb nicht" VerticalAlignment="Center" Click="DismissSuggestion"
                                            AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: führt der Betrieb nicht'}" AutomationProperties.AutomationId="SuggestionDismiss">
                                        <PathIcon Data="{StaticResource ClearIcon}" Width="10" Height="10"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ui:Screen>
