<UserControl x:Class="Umsatzschaetzung.App.Ui.SourceView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="−" Theme="{StaticResource LinkButton}" Click="ZoomOut" MinWidth="32"
                        AutomationProperties.Name="Verkleinern" AutomationProperties.AcceleratorKey="-" AutomationProperties.AutomationId="SourceZoomOut"/>
                <TextBlock Text="{Binding #Viewer.(ui:ZoomPan.Zoom), StringFormat='{}{0:P0}'}"
                           VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <Button Content="+" Theme="{StaticResource LinkButton}" Click="ZoomIn" MinWidth="32"
                        AutomationProperties.Name="Vergrößern" AutomationProperties.AcceleratorKey="+" AutomationProperties.AutomationId="SourceZoomIn"/>
                <Button Content="Anpassen" Theme="{StaticResource LinkButton}" Click="ZoomReset"
                        AutomationProperties.HelpText="An die Breite anpassen" AutomationProperties.AcceleratorKey="0" AutomationProperties.AutomationId="SourceZoomFit"/>
            </StackPanel>
            <TextBlock x:Name="Note" Theme="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <ScrollViewer x:Name="Viewer" ui:ZoomPan.Enabled="True" Padding="12" AutomationProperties.Name="Beleg" AutomationProperties.AutomationId="SourceViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel x:Name="Pages" HorizontalAlignment="Left"/>
            </LayoutTransformControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
