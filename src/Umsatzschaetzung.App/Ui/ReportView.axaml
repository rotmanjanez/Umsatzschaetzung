<ui:Screen x:Class="Umsatzschaetzung.App.Ui.ReportView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           x:DataType="ui:ReportModel"
           Margin="0,12,0,0">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
            <TextBlock Text="{Binding Saved}" Theme="{StaticResource Muted}" IsVisible="{Binding ShowSaved}"
                       VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            <Button Theme="{StaticResource PrimaryButton}" ToolTip.Tip="Als PDF speichern" Click="SavePdf" IsEnabled="{Binding CanSave}">
                <Panel>
                    <PathIcon Theme="{StaticResource Spinner}" IsVisible="{Binding Busy}"/>
                    <PathIcon Data="{StaticResource ExportIcon}" Width="14" Height="14" IsVisible="{Binding !Busy}"/>
                </Panel>
            </Button>
        </StackPanel>
        <Border Theme="{StaticResource Panel}">
            <Grid>
                <NativeWebView x:Name="Web"/>
                <TextBlock Text="{Binding Note}" Theme="{StaticResource EmptyState}" IsVisible="{Binding ShowNote}"/>
            </Grid>
        </Border>
    </DockPanel>
</ui:Screen>
