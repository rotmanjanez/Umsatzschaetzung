<ui:Screen x:Class="Umsatzschaetzung.App.Ui.ReportView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           x:DataType="ui:ReportModel"
           Margin="0,12,0,0">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
            <TextBlock Text="{Binding Saved}" Theme="{StaticResource Muted}" IsVisible="{Binding ShowSaved}"
                       VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            <Button Content="{Binding PdfLabel}" Theme="{StaticResource PrimaryButton}" Click="SavePdf" IsEnabled="{Binding CanSave}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Nicht berücksichtigte Einkäufe" Theme="{StaticResource SectionHeader}"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16" ColumnDefinitions="Auto,*">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Erfasste Einkäufe (netto)" Theme="{StaticResource KeyLabel}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Purchases}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="davon in der Kalkulation" Theme="{StaticResource KeyLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Included}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Text="Nicht berücksichtigt" Theme="{StaticResource KeyLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Excluded}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                </Grid>
                <TextBlock Text="Keine" Theme="{StaticResource Muted}" IsVisible="{Binding NoExcluded}"/>
            </StackPanel>
            <DataGrid Grid.Column="1" ui:Grids.Flex="2" Theme="{StaticResource Grid}" ItemsSource="{Binding Rows}" IsReadOnly="True" MaxHeight="240" Margin="24,0,0,0" IsVisible="{Binding HasExcluded}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name, DataType=ui:ExcludedLineRow}" Width="260" MinWidth="140"/>
                    <DataGridTemplateColumn Header="Grund" Width="220" SortMemberPath="Reason">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="ui:ExcludedLineRow">
                                <TextBlock Text="{Binding Reason}" Theme="{StaticResource Muted}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Netto" Width="110" SortMemberPath="Net">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="ui:ExcludedLineRow">
                                <TextBlock Text="{Binding LineNet}" Theme="{StaticResource Number}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Border Theme="{StaticResource Panel}">
            <Grid>
                <NativeWebView x:Name="Web"/>
                <TextBlock Text="{Binding Note}" Theme="{StaticResource EmptyState}" IsVisible="{Binding ShowNote}"/>
            </Grid>
        </Border>
    </DockPanel>
</ui:Screen>
