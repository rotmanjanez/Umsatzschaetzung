<ui:Screen x:Class="Umsatzschaetzung.App.Ui.InvoiceView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschaetzung.App.Ui"
           x:DataType="ui:InvoiceModel">
    <ui:Screen.Styles>
        <Style Selector="TextBox.flagged /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
        </Style>
        <Style Selector="Rectangle.flagged">
            <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
            <Setter Property="Fill" Value="{DynamicResource WarningSoftBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="RadiusX" Value="3"/>
            <Setter Property="RadiusY" Value="3"/>
        </Style>
        <Style Selector="Border#State.auto">
            <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
        </Style>
        <Style Selector="Border#State.manual">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
        </Style>
        <Style Selector="Border#State.pending">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
        </Style>
        <Style Selector="Border.cell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Border.cell.flagged">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>
    </ui:Screen.Styles>
    <Grid x:Name="Panes">
        <Grid.RowDefinitions>
            <RowDefinition Height="11*" MinHeight="240"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="9*" MinHeight="120"/>
        </Grid.RowDefinitions>
        <Border x:Name="FormPane" Grid.Row="0" Theme="{StaticResource Panel}" Padding="16,12" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Top">
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Theme="{StaticResource HelpButton}" Margin="8,0,0,0" Click="ShowHelp"/>
                    <Button x:Name="AcceptInvoice" DockPanel.Dock="Right" Theme="{StaticResource PrimaryButton}" ToolTip.Tip="Bestätigen" IsEnabled="{Binding CanAccept}" Click="Accept">
                        <Panel>
                            <PathIcon Theme="{StaticResource Spinner}" IsVisible="{Binding Saving}"/>
                            <PathIcon Data="{StaticResource ConfirmIcon}" Width="14" Height="14" IsVisible="{Binding !Saving}"/>
                        </Panel>
                    </Button>
                    <Button DockPanel.Dock="Right" Theme="{StaticResource SecondaryButton}" ToolTip.Tip="CSV exportieren" Margin="0,0,8,0" IsEnabled="{Binding CanExport}" Click="ExportCsv">
                        <PathIcon Data="{StaticResource ExportIcon}" Width="14" Height="14"/>
                    </Button>
                    <Border x:Name="State" DockPanel.Dock="Right" Theme="{StaticResource Badge}" Margin="12,0"
                            VerticalAlignment="Center"
                            Classes.auto="{Binding IsAutomatic}" Classes.manual="{Binding IsManual}" Classes.pending="{Binding IsPending}">
                        <TextBlock Text="{Binding StateText}" Theme="{StaticResource BadgeText}"/>
                    </Border>
                    <TextBlock Text="Rechnung" Theme="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Row="1">
                    <Grid ColumnDefinitions="*,12,*,12,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lieferant" Theme="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SupplierBox" Text="{Binding Supplier, Mode=TwoWay}" GotFocus="HeaderFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rechnungsnummer" Theme="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NumberBox" Text="{Binding Number, Mode=TwoWay}" GotFocus="HeaderFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <DockPanel>
                                <Border Theme="{StaticResource BadgeWarning}" DockPanel.Dock="Right" IsVisible="{Binding OutsidePeriod}" ToolTip.Tip="{Binding PeriodHint}">
                                    <TextBlock Text="Außerhalb des Zeitraums" Theme="{StaticResource BadgeText}"/>
                                </Border>
                                <TextBlock Text="Datum" Theme="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <TextBox x:Name="DateBox" Text="{Binding Date, Mode=TwoWay}" GotFocus="HeaderFocus"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="Beleg" Theme="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding HeaderFlags}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Theme="{StaticResource Banner}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Positionen" Theme="{StaticResource SectionHeader}" Margin="0,8,0,8"/>
                </StackPanel>
                <DataGrid x:Name="Lines" Grid.Row="2" ui:Grids.Flex="2" Theme="{StaticResource Grid}" ItemsSource="{Binding Lines}" CurrentCellChanged="CellChanged" PreparingCellForEdit="EditStarted">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Menge" Width="90" SortMemberPath="Quantity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <Border Classes="cell" Classes.flagged="{Binding QuantityFlagged}" ToolTip.Tip="{Binding QuantityFlag}">
                                        <TextBlock Text="{Binding Quantity}" Theme="{StaticResource Cell}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <TextBox Text="{Binding Quantity, Mode=TwoWay}" Theme="{StaticResource NumberBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Einheit" Width="110" SortMemberPath="UnitLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <Border Classes="cell" Classes.flagged="{Binding UnitFlagged}" ToolTip.Tip="{Binding UnitFlag}">
                                        <TextBlock Text="{Binding UnitLabel}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <TextBox Text="{Binding Unit, Mode=TwoWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Position" Width="280" MinWidth="140" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <Border Classes="cell" Classes.flagged="{Binding NameFlagged}" ToolTip.Tip="{Binding NameFlag}">
                                        <DockPanel>
                                            <PathIcon DockPanel.Dock="Right" Theme="{StaticResource RowWarning}"
                                                      IsVisible="{Binding RowFlagged}" ToolTip.Tip="{Binding RowFlag}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <TextBox Text="{Binding Name, Mode=TwoWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Einzelpreis" Width="110" SortMemberPath="UnitPrice">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <Border Classes="cell" Classes.flagged="{Binding UnitPriceFlagged}" ToolTip.Tip="{Binding UnitPriceFlag}">
                                        <TextBlock Text="{Binding UnitPrice}" Theme="{StaticResource Cell}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <TextBox Text="{Binding UnitPrice, Mode=TwoWay}" Theme="{StaticResource NumberBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Netto" Width="110" SortMemberPath="LineNet">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <Border Classes="cell" Classes.flagged="{Binding LineNetFlagged}" ToolTip.Tip="{Binding LineNetFlag}">
                                        <TextBlock Text="{Binding LineNet}" Theme="{StaticResource Cell}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <TextBox Text="{Binding LineNet, Mode=TwoWay}" Theme="{StaticResource NumberBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="USt" Width="70" SortMemberPath="Vat">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <Border Classes="cell" Classes.flagged="{Binding VatFlagged}" ToolTip.Tip="{Binding VatFlag}">
                                        <TextBlock Text="{Binding Vat}" Theme="{StaticResource Cell}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <TextBox Text="{Binding Vat, Mode=TwoWay}" Theme="{StaticResource NumberBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:LineRow">
                                    <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Entfernen" Click="RemoveLine">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="3" Content="Zeile hinzufügen" Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="AddLine"/>
                <DataGrid x:Name="Totals" Grid.Row="4" Theme="{StaticResource Grid}" Margin="0,8,0,0" CanUserSortColumns="False"
                          ItemsSource="{Binding Totals}" CurrentCellChanged="TotalChanged" PreparingCellForEdit="EditStarted">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Summe" Binding="{Binding Label, DataType=ui:TotalRow}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Laut Beleg" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:TotalRow">
                                    <Border Classes="cell" Classes.flagged="{Binding Flagged}" ToolTip.Tip="{Binding Flag}">
                                        <TextBlock Text="{Binding Stated}" Theme="{StaticResource Cell}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate x:DataType="ui:TotalRow">
                                    <TextBox Text="{Binding Stated, Mode=TwoWay}" Theme="{StaticResource NumberBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aus Positionen" Width="130" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="ui:TotalRow">
                                    <Border Classes="cell">
                                        <TextBlock Text="{Binding Sum}" Theme="{StaticResource Cell}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter x:Name="PaneSplit" Grid.Row="1" Height="6" ResizeDirection="Rows" Background="Transparent"/>

        <Border x:Name="ScanPane" Grid.Row="2" Theme="{StaticResource Panel}" ClipToBounds="True">
            <Grid>
                <DockPanel x:Name="OcrPane">
                    <DockPanel DockPanel.Dock="Top" Margin="12,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="−" Theme="{StaticResource LinkButton}" Click="ZoomOut" MinWidth="32"/>
                            <TextBlock Text="{Binding #Viewer.(ui:ZoomPan.Zoom), StringFormat='{}{0:P0}'}"
                                       VerticalAlignment="Center" MinWidth="48" TextAlignment="Center"/>
                            <Button Content="+" Theme="{StaticResource LinkButton}" Click="ZoomIn" MinWidth="32"/>
                            <Button Content="Anpassen" Theme="{StaticResource LinkButton}" Click="ZoomFit"/>
                            <ComboBox x:Name="PageSelect" MinWidth="120" Margin="8,0,0,0" SelectionChanged="PageChanged"/>
                        </StackPanel>
                        <TextBlock Text="Beleg" Theme="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer x:Name="Viewer" ui:ZoomPan.Enabled="True" Padding="12"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas x:Name="PageCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image x:Name="PageImage" Stretch="Fill"/>
                                <Canvas x:Name="Flagged"/>
                                <Rectangle x:Name="FocusBox" Stroke="{DynamicResource FocusBoxBrush}" StrokeThickness="3" RadiusX="3" RadiusY="3" IsVisible="False"/>
                            </Canvas>
                        </LayoutTransformControl>
                    </ScrollViewer>
                </DockPanel>
                <ui:SourceView x:Name="Source" IsVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</ui:Screen>
