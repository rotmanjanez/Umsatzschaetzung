<Project Sdk="Microsoft.NET.Sdk">
  <!-- The interface every head shares; the desktop's start and its web view are Umsatzschaetzung.Desktop's. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Umsatzschaetzung.App</RootNamespace>
    <!-- Views take a Session and are only ever constructed in code, never fetched
         from the runtime XAML loader by URI, which is all AVLN3001 warns about. -->
    <NoWarn>AVLN3001</NoWarn>
    <ShipEmbeddings>true</ShipEmbeddings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="headless" />
    <InternalsVisibleTo Include="Umsatzschaetzung.Web" />
    <InternalsVisibleTo Include="Umsatzschaetzung.Tests" />
    <InternalsVisibleTo Include="Umsatzschaetzung.Browser" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Ui/Assets/logo.svg" />
    <AvaloniaResource Include="Ui/Assets/logo-256.png" />
    <AvaloniaResource Include="Ui/Assets/Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Umsatzschaetzung.Core/Umsatzschaetzung.Core.csproj" />
    <ProjectReference Include="../Umsatzschaetzung.Documents/Umsatzschaetzung.Documents.csproj" />
    <ProjectReference Include="../Umsatzschaetzung.Inference/Umsatzschaetzung.Inference.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <Import Project="../../Embeddings.targets" />
</Project>
