AddType application/wasm .wasm
AddType text/javascript .js .mjs
AddType application/octet-stream .onnx .dat .db

RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^app\.umsatzschaetzung\.amtstools\.de$ [NC]
RewriteRule ^(.*)$ https://app.umsatzschaetzung.amtstools.de/$1 [R=301,L]

# The lessons are listed in the documentation.
RewriteRule ^lektionen/?$ https://docs.umsatzschaetzung.amtstools.de/uebungen/ [R=302,L]

RewriteCond %{HTTP:Accept-Encoding} br
RewriteCond %{REQUEST_FILENAME}.br -s
RewriteRule ^(.*)$ $1.br [L]

# Already compressed: the server's own compression would wrap it in gzip under a header that says br.
<FilesMatch "\.br$">
  SetEnv no-gzip 1
  SetEnv no-brotli 1
</FilesMatch>

<FilesMatch "\.wasm\.br$">
  ForceType application/wasm
</FilesMatch>
<FilesMatch "\.m?js\.br$">
  ForceType text/javascript
</FilesMatch>
<FilesMatch "\.json\.br$">
  ForceType application/json
</FilesMatch>
<FilesMatch "\.html\.br$">
  ForceType text/html
</FilesMatch>
<FilesMatch "\.svg\.br$">
  ForceType image/svg+xml
</FilesMatch>
<FilesMatch "\.(dat|db)\.br$">
  ForceType application/octet-stream
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>

  # Isolated, so the runtime's CPU fallback may run on several threads.
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Embedder-Policy "require-corp"

  # Nothing leaves for another host, whatever a script asks.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self'; worker-src 'self' blob:; object-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors 'self'"
  Header set Referrer-Policy "no-referrer"

  # The page the Bericht's frames fill: its own styles apply, nothing loads.
  <FilesMatch "^bericht\.html(\.br)?$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; form-action 'none'; base-uri 'none'; frame-ancestors 'self'"
  </FilesMatch>

  # Weights and runtime sit under their release; the framework's files carry their hash, and
  # a lesson's clips are named by what they say. What names them is asked again on every visit.
  Header set Cache-Control "no-cache"
  <If "%{REQUEST_URI} =~ m#^/(models|ort|lektionen/ton)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/_framework/# && %{REQUEST_URI} !~ m#/dotnet\.js(\.br)?$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </ElseIf>
</IfModule>
