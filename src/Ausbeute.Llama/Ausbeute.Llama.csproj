<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ausbeute.Llama</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <LlmArch>$(RuntimeIdentifier)</LlmArch>
    <LlmArch Condition="'$(LlmArch)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</LlmArch>
    <LlmDll>$(MSBuildThisFileDirectory)..\..\third_party\llama\build\$(LlmArch)\ausbeute_llm.dll</LlmDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ausbeute.Core/Ausbeute.Core.csproj" />
    <None Include="$(LlmDll)" Link="ausbeute_llm.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(LlmDll)')" />
  </ItemGroup>
</Project>
