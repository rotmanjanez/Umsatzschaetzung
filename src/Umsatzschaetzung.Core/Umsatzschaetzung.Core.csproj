<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Umsatzschaetzung</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.macOS" Version="155.0.8057" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="155.0.8057" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Pinned, not inherited from RapidOcrNet: the tagger's weights are per-channel int8,
         which ORT only reads back correctly from 1.27 on. A transitive bump would change
         which CPU kernel runs and would not show up in any diff here. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
    <!-- RapidOcrNet brings only the Linux Skia binaries with it. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ocr-check" />
    <InternalsVisibleTo Include="richtsatz" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/rechenweg.md" LogicalName="rechenweg.md" />
    <EmbeddedResource Include="Rulestore/seed.json" LogicalName="seed.json" />
    <EmbeddedResource Include="../../data/units.json" LogicalName="units.json" />
    <EmbeddedResource Include="../../data/richtsatz/*.json" LogicalName="richtsatz/%(Filename).json" />
  </ItemGroup>
  <!-- The tagger and the v6 detector are not in the repo: they are fetched from their
       own releases, verified and declared as content. See Models.targets. -->
  <Import Project="../../Models.targets" />
  <!-- RapidOcrNet copies its ONNX models next to its own build output, and build
       targets do not travel across a project reference, so anything referencing Core
       would come up without models. Declare them as content instead: that does travel. -->
  <Target Name="RapidOcrModels" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <ContentWithTargetPath Include="@(Models)" TargetPath="models/v5/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
