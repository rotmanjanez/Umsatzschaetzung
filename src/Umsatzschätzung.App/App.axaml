<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Umsatzschätzung.App.App"
             Name="Umsatzschätzung"
             RequestedThemeVariant="Default">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Über Umsatzschätzung" Click="About"/>
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <!-- A ControlTheme may not carry descendant selectors, so the cell alignment lives here. -->
        <Style Selector="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        </Style>
        <Style Selector="TextBox.invalid, ComboBox.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector=":is(Control).invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <!-- AutoCompleteBox draws its border in the inner TextBox, out of reach of the selector above. -->
        <Style Selector="AutoCompleteBox.invalid /template/ TextBox#PART_TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Ui/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
