<ui:Screen x:Class="Umsatzschätzung.App.Ui.InvoicesView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           Margin="24" AllowDrop="True" Drop="Dropped" DragOver="DragOverFiles">
    <ui:Screen.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </ui:Screen.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Rechnungen hinzufügen" Style="{StaticResource PrimaryButton}" Click="AddFiles" VerticalAlignment="Top"/>
            <TextBlock Text="Rechnungen" Style="{StaticResource PageTitle}"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="16*" MinWidth="480"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <ui:SearchBox x:Name="Search" DockPanel.Dock="Top" Width="Auto" Margin="8"/>
                    <Grid>
                    <ListBox x:Name="List" ItemsSource="{Binding Invoices}" SelectionChanged="SelectionChanged" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Supplier}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Noch keine Rechnungen" Style="{StaticResource EmptyState}" Visibility="{Binding Empty, Converter={StaticResource Vis}}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
                <TextBlock x:Name="EmptyDetail" Text="Keine Rechnung gewählt" Style="{StaticResource EmptyState}"/>
                <Grid x:Name="Detail" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="9*" MinHeight="160"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="11*" MinHeight="160"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="16,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="Supplier" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Nummer" Style="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Number" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                    <TextBlock Text="Datum" Style="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Date" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Netto" Style="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Net" Style="{StaticResource Number}" Margin="0,0,24,0"/>
                                    <TextBlock Text="Brutto" Style="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Gross" Style="{StaticResource Number}"/>
                                </StackPanel>
                                <TextBlock Text="Positionen" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <DataGrid x:Name="LinesGrid" Style="{StaticResource Grid}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Position" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="100" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice}" Width="110" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="Netto" Binding="{Binding LineNet}" Width="110" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="USt." Binding="{Binding Vat}" Width="70" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTemplateColumn Header="Zuordnung" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Border Style="{StaticResource BadgeSuccess}" Visibility="{Binding Mapped, Converter={StaticResource Vis}}" ToolTip="{Binding Mapping}">
                                                        <TextBlock Text="{Binding Mapping}" Style="{StaticResource BadgeText}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeWarning}" Visibility="{Binding Unmapped, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="Nicht zugeordnet" Style="{StaticResource BadgeText}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Border Grid.Row="2" Style="{StaticResource Panel}">
                        <ui:SourceView x:Name="Source"/>
                    </Border>
                </Grid>
                <ContentControl x:Name="VerifyHost" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </DockPanel>
</ui:Screen>
