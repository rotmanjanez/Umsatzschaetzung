<Window x:Class="Umsatzschätzung.App.Ui.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20,16">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Height="6" Margin="0,12" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Eta}" Style="{StaticResource Muted}" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" Click="CancelClick"/>
    </StackPanel>
</Window>
