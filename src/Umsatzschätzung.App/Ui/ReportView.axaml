<ui:Screen x:Class="Umsatzschätzung.App.Ui.ReportView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           x:DataType="ui:ReportModel"
           Margin="0,12,0,0">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="CSV exportieren" Theme="{StaticResource SecondaryButton}" Click="ExportCsv"/>
                <Button Content="Als PDF speichern" Theme="{StaticResource PrimaryButton}" Click="SavePdf" IsEnabled="{Binding Ready}"/>
            </StackPanel>
            <TextBlock Text="Bericht" Theme="{StaticResource PageTitle}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Nicht berücksichtigte Einkäufe" Theme="{StaticResource SectionHeader}"/>
        <Border DockPanel.Dock="Top" Theme="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Erfasste Einkäufe (netto)" Theme="{StaticResource KeyLabel}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Purchases}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="davon in der Kalkulation" Theme="{StaticResource KeyLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Included}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Text="Nicht berücksichtigt" Theme="{StaticResource KeyLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Excluded}" Theme="{StaticResource Number}" Margin="0,0,0,6"/>
                </Grid>
                <TextBlock Text="Keine" Theme="{StaticResource Muted}" IsVisible="{Binding NoExcluded}"/>
                <Expander Header="Positionen anzeigen" IsVisible="{Binding HasExcluded}">
                    <DataGrid Theme="{StaticResource Grid}" ItemsSource="{Binding Rows}" IsReadOnly="True" MaxHeight="240" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rechnung" Binding="{Binding Invoice, DataType=ui:ExcludedLineRow}" Width="160"/>
                            <DataGridTemplateColumn Header="Pos." Width="60" SortMemberPath="LineNo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:ExcludedLineRow">
                                        <TextBlock Text="{Binding LineNo}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name, DataType=ui:ExcludedLineRow}" Width="*"/>
                            <DataGridTemplateColumn Header="Grund" Width="220" SortMemberPath="Reason">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:ExcludedLineRow">
                                        <TextBlock Text="{Binding Reason}" Theme="{StaticResource Muted}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Netto" Width="110" SortMemberPath="LineNet">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:ExcludedLineRow">
                                        <TextBlock Text="{Binding LineNet}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </StackPanel>
        </Border>
        <Border Theme="{StaticResource Panel}">
            <Grid>
                <NativeWebView x:Name="Web"/>
                <TextBlock Text="{Binding Note}" Theme="{StaticResource EmptyState}" IsVisible="{Binding ShowNote}"/>
            </Grid>
        </Border>
    </DockPanel>
</ui:Screen>
