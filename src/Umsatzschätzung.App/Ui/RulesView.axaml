<ui:Screen x:Class="Umsatzschätzung.App.Ui.RulesView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           x:DataType="ui:RulesModel"
           Margin="24">
    <DockPanel>
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">

            <TabItem Header="Zutaten">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="62*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button DockPanel.Dock="Right" Content="Neu" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="NewIngredient"/>
                                <ui:SearchBox x:Name="IngredientSearch" Width="NaN"/>
                            </DockPanel>
                            <Grid>
                                <DataGrid x:Name="IngredientGrid" Theme="{StaticResource Grid}" IsReadOnly="True" SelectionChanged="IngredientSelected">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="ui:IngredientItem">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ui:NoResults Search="{Binding #IngredientSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Ingredients}" x:DataType="ui:IngredientForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Zutat auswählen, um sie zu bearbeiten – oder mit „Neu“ eine neue anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Basiseinheit *" Theme="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedIndex="{Binding UnitIndex}" Classes.invalid="{Binding UnitInvalid}">
                                            <ComboBoxItem Content="Milliliter (ml)"/>
                                            <ComboBoxItem Content="Gramm (g)"/>
                                            <ComboBoxItem Content="Stück"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kategorie" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Category, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="Speichern" Theme="{StaticResource PrimaryButton}" Click="SaveIngredient" Margin="0,0,8,0"/>
                                    <Button Content="Zurückziehen" Theme="{StaticResource DangerLink}" Click="RetireIngredient" IsVisible="{Binding Retirable}"/>
                                    <Border Theme="{StaticResource BadgeWarning}" IsVisible="{Binding Retired}">
                                        <TextBlock Text="{Binding RetiredLabel}" Theme="{StaticResource BadgeText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding RetireHint}" Theme="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding Existing}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Produkte">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="62*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button DockPanel.Dock="Right" Content="Neu" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="NewProduct"/>
                                <ui:SearchBox x:Name="ProductSearch" Width="NaN"/>
                            </DockPanel>
                            <Grid>
                                <DataGrid x:Name="ProductGrid" Theme="{StaticResource Grid}" IsReadOnly="True" SelectionChanged="ProductSelected">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="ui:ProductItem">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ui:NoResults Search="{Binding #ProductSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Products}" x:DataType="ui:ProductForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links ein Produkt auswählen, um es zu bearbeiten – oder mit „Neu“ ein neues anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"/>
                                <TextBlock Text="Rezept *" Theme="{StaticResource SectionHeader}" Margin="0,20,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zutat" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Column="1" Text="Menge je Portion" Theme="{StaticResource FieldLabel}" Margin="8,0,48,4"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Recipe}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:RecipeRow">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:IngredientBox ItemsSource="{Binding Options}" SelectedItem="{Binding Ingredient, Mode=TwoWay}"
                                                                  Classes.invalid="{Binding IngredientInvalid}" HorizontalAlignment="Stretch"/>
                                                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UnitLabel}" Theme="{StaticResource Muted}"
                                                               FontSize="12" Width="42" Margin="6,0,0,0"/>
                                                    <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Amount, Mode=TwoWay}"
                                                             Classes.invalid="{Binding AmountInvalid}"/>
                                                </DockPanel>
                                                <Button Grid.Column="2" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Entfernen" HorizontalAlignment="Right" Click="RemoveRecipeLine">
                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Zutat hinzufügen" Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="AddRecipeLine"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="Speichern" Theme="{StaticResource PrimaryButton}" Click="SaveProduct" Margin="0,0,8,0"/>
                                    <Button Content="Zurückziehen" Theme="{StaticResource DangerLink}" Click="RetireProduct" IsVisible="{Binding Retirable}"/>
                                    <Border Theme="{StaticResource BadgeWarning}" IsVisible="{Binding Retired}">
                                        <TextBlock Text="{Binding RetiredLabel}" Theme="{StaticResource BadgeText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding RetireHint}" Theme="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding Existing}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Ertragsregeln">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38*" MinWidth="260"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="62*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Theme="{StaticResource Panel}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8">
                                <Button DockPanel.Dock="Right" Content="Neu" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="NewYield"/>
                                <ui:SearchBox x:Name="YieldSearch" Width="NaN"/>
                            </DockPanel>
                            <Grid>
                                <DataGrid x:Name="YieldGrid" Theme="{StaticResource Grid}" IsReadOnly="True" SelectionChanged="YieldSelected">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Gilt für" Width="*" SortMemberPath="Title">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="ui:YieldItem">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ui:NoResults Search="{Binding #YieldSearch}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Grid Grid.Column="2" DataContext="{Binding Yields}" x:DataType="ui:YieldForm">
                        <TextBlock Theme="{StaticResource EmptyState}" IsVisible="{Binding !Active}" MaxWidth="300" TextAlignment="Center"
                                   Text="Links eine Ertragsregel auswählen, um sie zu bearbeiten – oder mit „Neu“ eine neue anlegen."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Active}">
                            <StackPanel Margin="8,0,16,16">
                                <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" Classes.invalid="{Binding NameInvalid}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Content="Standardregel" IsChecked="{Binding IsDefault}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kategorie" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Category, Mode=TwoWay}" Classes.invalid="{Binding ScopeInvalid}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Zutat" Theme="{StaticResource FieldLabel}"/>
                                        <ui:IngredientBox ItemsSource="{Binding IngredientOptions}" SelectedItem="{Binding Ingredient, Mode=TwoWay}"
                                                          Classes.invalid="{Binding ScopeInvalid}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Kategorie oder Zutat angeben" Theme="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Schwund * (in %)" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Shrinkage, Mode=TwoWay}" Classes.invalid="{Binding ShrinkageInvalid}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Eigenverbrauch * (in %)" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding OwnUse, Mode=TwoWay}" Classes.invalid="{Binding OwnUseInvalid}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Personal * (in %)" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Staff, Mode=TwoWay}" Classes.invalid="{Binding StaffInvalid}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Freigetränke * (in %)" Theme="{StaticResource FieldLabel}"/>
                                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Free, Mode=TwoWay}" Classes.invalid="{Binding FreeInvalid}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Quelle *" Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Source, Mode=TwoWay}" Classes.invalid="{Binding SourceInvalid}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="Speichern" Theme="{StaticResource PrimaryButton}" Click="SaveYield" Margin="0,0,8,0"/>
                                    <Button Content="Zurückziehen" Theme="{StaticResource DangerLink}" Click="RetireYield" IsVisible="{Binding Retirable}"/>
                                    <Border Theme="{StaticResource BadgeWarning}" IsVisible="{Binding Retired}">
                                        <TextBlock Text="{Binding RetiredLabel}" Theme="{StaticResource BadgeText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding RetireHint}" Theme="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding Existing}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:Screen>
