<ui:Screen x:Class="Umsatzschätzung.App.Ui.CasesView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           xmlns:svc="clr-namespace:Umsatzschätzung.Service;assembly=Umsatzschätzung.Core"
           x:DataType="ui:CasesModel"
           Margin="24">
    <ui:Screen.Styles>
        <Style Selector="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </ui:Screen.Styles>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:SearchBox x:Name="Search" Margin="0,0,16,0"/>
                <Button Content="Regeln" Theme="{StaticResource SecondaryButton}" Click="ShowRules"/>
                <Button Content="Importieren" Theme="{StaticResource SecondaryButton}" Click="Import"/>
                <Button Content="Neue Prüfung" Theme="{StaticResource PrimaryButton}" Click="StartNew"/>
            </StackPanel>
            <TextBlock Text="Prüfungen" Theme="{StaticResource PageTitle}"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Theme="{StaticResource Card}" IsVisible="{Binding Creating}">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Neue Prüfung" Theme="{StaticResource SectionHeader}"/>
                <TextBlock Text="Bezeichnung *" Theme="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NewLabel" Width="520" HorizontalAlignment="Left"/>
                <Grid Width="520" HorizontalAlignment="Left" ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Zeitraum von *" Theme="{StaticResource FieldLabel}"/>
                        <ui:DateBox x:Name="NewFrom"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Zeitraum bis *" Theme="{StaticResource FieldLabel}"/>
                        <ui:DateBox x:Name="NewTo"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Steuerpflichtiger" Theme="{StaticResource SectionHeader}" Margin="0,20,0,0"/>
                <TextBlock Text="Name *" Theme="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NewName" Width="520" HorizontalAlignment="Left"/>
                <Grid Width="520" HorizontalAlignment="Left" ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Steuernummer *" Theme="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NewTaxNumber"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PaB-Nr. *" Theme="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NewPab"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Gewerbekennzahl" Theme="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NewGewerbe" Width="252" HorizontalAlignment="Left" PlaceholderText="z. B. 56101.0 (Richtsatzsammlung)"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Anlegen" Theme="{StaticResource PrimaryButton}" Click="Create" Margin="0,0,8,0"/>
                    <Button Content="Abbrechen" Theme="{StaticResource SecondaryButton}" Click="CancelNew"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid>
            <DataGrid x:Name="Grid" ui:Grids.Flex="0" Theme="{StaticResource Grid}" IsReadOnly="True" KeyDown="GridKeyDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Bezeichnung" Width="320" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:CaseRow">
                                <TextBlock Text="{Binding Case.Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Zeitraum" Binding="{Binding Period, DataType=svc:CaseRow}" Width="200"/>
                    <DataGridTemplateColumn Header="Zuletzt geändert" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:CaseRow">
                                <TextBlock Text="{Binding UpdatedAt}" Theme="{StaticResource Muted}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="svc:CaseRow">
                                <Button Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="Delete">
                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ui:NoResults Search="{Binding #Search}"/>
            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowEmpty}">
                <TextBlock Text="Noch keine Prüfungen" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center"
                           Text="Eine Prüfung hält Zeitraum, Steuerpflichtigen, Rechnungen und Kalkulation zusammen. Legen Sie eine neue Prüfung an oder importieren Sie eine gespeicherte Prüfungsdatei."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Importieren" Theme="{StaticResource SecondaryButton}" Click="Import"/>
                    <Button Content="Neue Prüfung" Theme="{StaticResource PrimaryButton}" Click="StartNew"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</ui:Screen>
