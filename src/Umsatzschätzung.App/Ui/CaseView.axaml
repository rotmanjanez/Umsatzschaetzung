<ui:Screen x:Class="Umsatzschätzung.App.Ui.CaseView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           xmlns:model="clr-namespace:Umsatzschätzung.Model;assembly=Umsatzschätzung.Core"
           x:DataType="ui:CaseModel"
           Margin="0,12,0,0">
    <ui:Screen.Resources>
        <DataTemplate x:Key="YieldGroupTemplate" x:DataType="ui:YieldKindGroup">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Kind}" Theme="{StaticResource FieldLabel}"/>
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="ui:YieldGroupRow">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="YieldDetailTemplate" x:DataType="ui:YieldGroupRow">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="ui:RuleOption">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip.Tip="{Binding Source}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DataTemplate>
    </ui:Screen.Resources>

    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960" HorizontalAlignment="Left" Margin="0,0,16,0">
                <Border Theme="{StaticResource Card}" IsVisible="{Binding NoInvoices}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Zu den Rechnungen" Theme="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" Click="GoInvoices"/>
                        <StackPanel>
                            <TextBlock Text="Nächster Schritt: Rechnungen" Theme="{StaticResource SectionHeader}"/>
                            <TextBlock Theme="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Zuordnung und Kalkulation entstehen aus den Rechnungen des Zeitraums. Angaben auf dieser Seite können jederzeit nachgetragen werden."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Expander Header="Eckdaten bearbeiten" Margin="0,0,0,24">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Bezeichnung *" Theme="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Label, Mode=TwoWay}" Width="440" HorizontalAlignment="Left"/>
                        <TextBlock Text="Zeitraum" Theme="{StaticResource SectionHeader}" Margin="0,20,0,0"/>
                        <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,4">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Von *" Theme="{StaticResource FieldLabel}"/>
                                <ui:DateBox Text="{Binding From, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bis *" Theme="{StaticResource FieldLabel}"/>
                                <ui:DateBox Text="{Binding To, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Steuerpflichtiger" Theme="{StaticResource SectionHeader}" Margin="0,20,0,0"/>
                        <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,4">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name" Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}"/>
                                <TextBlock Text="PaB-Nr." Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Pab, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Steuernummer" Theme="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding TaxNumber, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <TextBlock Text="Erklärte Umsätze, netto in €" Theme="{StaticResource SectionHeader}"/>
                <Grid Margin="0,0,0,24" ColumnDefinitions="*,16,*,16,*">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Umsatz zu 19 %" Theme="{StaticResource FieldLabel}"/>
                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Declared19, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Umsatz zu 7 %" Theme="{StaticResource FieldLabel}"/>
                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Declared7, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Umsatz zu 0 %" Theme="{StaticResource FieldLabel}"/>
                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Declared0, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Bestand" Theme="{StaticResource SectionHeader}"/>
                <StackPanel Margin="0,0,0,24">
                    <Grid ColumnDefinitions="*,140,140,90" Margin="0,0,0,4">
                        <TextBlock Text="Zutat" Theme="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Text="Anfangsbestand" Theme="{StaticResource FieldLabel}" Margin="8,10,0,4"/>
                        <TextBlock Grid.Column="2" Text="Endbestand" Theme="{StaticResource FieldLabel}" Margin="8,10,0,4"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Stock}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:StockRow">
                                <Grid ColumnDefinitions="*,140,140,90" Margin="0,0,0,6">
                                    <ComboBox ItemsSource="{Binding Options}" DisplayMemberBinding="{Binding Name, DataType=model:Ingredient}" SelectedItem="{Binding Ingredient, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                    <TextBox Grid.Column="1" Theme="{StaticResource NumberBox}" Margin="8,0,0,0" Text="{Binding Opening, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="2" Theme="{StaticResource NumberBox}" Margin="8,0,0,0" Text="{Binding Closing, Mode=TwoWay}"/>
                                    <Button Grid.Column="3" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Entfernen" Click="RemoveStock" HorizontalAlignment="Right">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Zutat hinzufügen" Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="AddStock" Margin="0,4,0,0"/>
                </StackPanel>

                <Expander x:Name="YieldRules" Header="Ertragsregeln" Margin="0,8,0,16">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Theme="{StaticResource Muted}" TextWrapping="Wrap" IsVisible="{Binding NoYields}"
                                   Text="Sobald Rechnungen zugeordnet sind, erscheinen hier die Ertragsregeln der betroffenen Kategorien und Zutaten."/>
                        <Grid ColumnDefinitions="260,24,*" IsVisible="{Binding !NoYields}">
                            <ItemsControl ItemsSource="{Binding Yields}" ItemTemplate="{StaticResource YieldGroupTemplate}"/>
                            <Grid Grid.Column="2">
                                <TextBlock Theme="{StaticResource EmptyState}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           IsVisible="{Binding NoDetail}" Text="Links eine Kategorie auswählen."/>
                                <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource YieldDetailTemplate}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:Screen>
