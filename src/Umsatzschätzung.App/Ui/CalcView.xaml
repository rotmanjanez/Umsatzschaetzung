<ui:Screen x:Class="Umsatzschätzung.App.Ui.CalcView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           xmlns:svc="clr-namespace:Umsatzschätzung.Service;assembly=Umsatzschätzung.Core"
           Margin="24">
    <ui:Screen.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <HierarchicalDataTemplate DataType="{x:Type svc:NodeDisplay}" ItemsSource="{Binding Inputs}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Number}"/>
            </Grid>
        </HierarchicalDataTemplate>
        <Style x:Key="RevenueRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Total}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProductRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Disabled}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:Screen.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="Wird neu berechnet …" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,6,0,0" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
            <TextBlock Text="Kalkulation" Style="{StaticResource PageTitle}"/>
        </DockPanel>
        <Grid>
            <TextBlock Text="Wird berechnet …" Style="{StaticResource EmptyState}" Visibility="{Binding NoResult, Converter={StaticResource Vis}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Produkte" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DataGrid x:Name="ProductGrid" Style="{StaticResource Grid}" ItemsSource="{Binding Products}" RowStyle="{StaticResource ProductRow}" IsReadOnly="True" SelectionUnit="Cell">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produkt" Binding="{Binding Name}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Portionen" Binding="{Binding Portions}" Width="130" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTemplateColumn Header="Bruttopreis" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="USt" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding VatNames}" SelectedIndex="{Binding VatIndex}" Margin="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Umsatz (netto)" Binding="{Binding Revenue}" Width="140" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTemplateColumn Header="aktiv" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Active}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeWarning}" Visibility="{Binding PriceMissing, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Preis fehlt" Style="{StaticResource BadgeText}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Expander Header="Fixierte Portionen" Margin="0,12,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Produkt" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Column="1" Text="Portionen" Style="{StaticResource FieldLabel}" Margin="8,0,0,4"/>
                                        <TextBlock Grid.Column="2" Text="Begründung" Style="{StaticResource FieldLabel}" Margin="8,0,0,4"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Pinned}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedItem="{Binding Product}"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Margin="8,0,0,0" Text="{Binding Portions, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="3" Content="&#xE74D;" Style="{StaticResource DangerIcon}" ToolTip="Entfernen" HorizontalAlignment="Right" Click="RemovePinned"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Produkt hinzufügen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="AddPinned"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Umsätze vor und nach Betriebsprüfung" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}">
                        <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Revenue}" RowStyle="{StaticResource RevenueRow}" IsReadOnly="True" IsHitTestVisible="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Steuersatz" Binding="{Binding Vat}" Width="*"/>
                                <DataGridTextColumn Header="Umsatz vor BP" Binding="{Binding Declared}" Width="170" ElementStyle="{StaticResource Number}"/>
                                <DataGridTextColumn Header="Umsatz nach BP" Binding="{Binding Calculated}" Width="170" ElementStyle="{StaticResource Number}"/>
                                <DataGridTextColumn Header="Differenz" Binding="{Binding Difference}" Width="170" ElementStyle="{StaticResource Number}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="Rechenweg" Style="{StaticResource SectionHeader}"/>
                    <Grid Height="440" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItemChanged="NodeSelected" BorderThickness="0" Background="Transparent"/>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16">
                            <Grid>
                                <TextBlock Text="Kein Rechenschritt gewählt" Style="{StaticResource EmptyState}" Visibility="{Binding NoNode, Converter={StaticResource Vis}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasNode, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Node.Label}" Style="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Node.Value}" Style="{StaticResource Number}" HorizontalAlignment="Left" FontSize="20" Margin="0,0,0,12"/>
                                        <TextBlock Text="Formel" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="{Binding Node.Formula}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Quellen" Style="{StaticResource FieldLabel}"/>
                                        <ItemsControl ItemsSource="{Binding Node.Sources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="Zusammenfassung" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Summary}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Key"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource KeyLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Number}" Margin="0,0,0,6"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:Screen>
