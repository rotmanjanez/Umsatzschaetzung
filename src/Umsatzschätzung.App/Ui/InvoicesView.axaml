<ui:Screen x:Class="Umsatzschätzung.App.Ui.InvoicesView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           x:DataType="ui:InvoicesModel"
           Margin="0,12,0,0" DragDrop.AllowDrop="True">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Rechnungen hinzufügen" Theme="{StaticResource PrimaryButton}" Click="AddFiles" VerticalAlignment="Top"/>
            <TextBlock Text="Rechnungen" Theme="{StaticResource PageTitle}"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="16*" MinWidth="480"/>
            </Grid.ColumnDefinitions>
            <Border Theme="{StaticResource Panel}">
                <DockPanel>
                    <ui:SearchBox x:Name="Search" DockPanel.Dock="Top" Width="NaN" Margin="8"/>
                    <Grid>
                        <ListBox x:Name="List" SelectionChanged="SelectionChanged" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="ui:InvoiceRow">
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding Supplier}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Sub}" Theme="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Noch keine Rechnungen" Theme="{StaticResource EmptyState}" IsVisible="{Binding Empty}"/>
                        <ui:NoResults Search="{Binding #Search}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
                <TextBlock x:Name="EmptyDetail" Text="Keine Rechnung gewählt" Theme="{StaticResource EmptyState}"/>
                <Grid x:Name="Detail" IsVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="9*" MinHeight="160"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="11*" MinHeight="160"/>
                    </Grid.RowDefinitions>
                    <Border Theme="{StaticResource Panel}" Padding="16,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="Supplier" Theme="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Nummer" Theme="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Number" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                    <TextBlock Text="Datum" Theme="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Date" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Netto" Theme="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Net" Theme="{StaticResource Number}" Margin="0,0,24,0"/>
                                    <TextBlock Text="Brutto" Theme="{StaticResource KeyLabel}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Gross" Theme="{StaticResource Number}"/>
                                </StackPanel>
                                <TextBlock Text="Positionen" Theme="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <DataGrid x:Name="LinesGrid" Theme="{StaticResource Grid}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Position" Binding="{Binding Name, DataType=ui:InvoiceLineRow}" Width="*"/>
                                    <DataGridTemplateColumn Header="Menge" Width="100" SortMemberPath="Quantity">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="ui:InvoiceLineRow">
                                                <TextBlock Text="{Binding Quantity}" Theme="{StaticResource Number}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Einzelpreis" Width="110" SortMemberPath="UnitPrice">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="ui:InvoiceLineRow">
                                                <TextBlock Text="{Binding UnitPrice}" Theme="{StaticResource Number}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Netto" Width="110" SortMemberPath="LineNet">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="ui:InvoiceLineRow">
                                                <TextBlock Text="{Binding LineNet}" Theme="{StaticResource Number}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="USt." Width="70" SortMemberPath="Vat">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="ui:InvoiceLineRow">
                                                <TextBlock Text="{Binding Vat}" Theme="{StaticResource Number}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Zuordnung" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="ui:InvoiceLineRow">
                                                <Grid>
                                                    <Border Theme="{StaticResource BadgeSuccess}" IsVisible="{Binding Mapped}" ToolTip.Tip="{Binding Mapping}">
                                                        <TextBlock Text="{Binding Mapping}" Theme="{StaticResource BadgeText}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    </Border>
                                                    <Border Theme="{StaticResource BadgeWarning}" IsVisible="{Binding Unmapped}">
                                                        <TextBlock Text="Nicht zugeordnet" Theme="{StaticResource BadgeText}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Border Grid.Row="2" Theme="{StaticResource Panel}">
                        <ui:SourceView x:Name="Source"/>
                    </Border>
                </Grid>
                <ContentControl x:Name="VerifyHost" IsVisible="False"/>
            </Grid>
        </Grid>
    </DockPanel>
</ui:Screen>
