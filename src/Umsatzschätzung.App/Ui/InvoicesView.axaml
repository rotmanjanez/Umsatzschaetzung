<ui:Screen x:Class="Umsatzschätzung.App.Ui.InvoicesView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           x:DataType="ui:InvoicesModel"
           Margin="0,12,0,0" DragDrop.AllowDrop="True">
    <ui:Screen.Resources>
        <DataTemplate x:Key="InvoiceRowTemplate" x:DataType="ui:InvoiceRow">
            <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                <StackPanel>
                    <TextBlock Text="{Binding Supplier}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" Theme="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Theme="{StaticResource DangerIcon}" ToolTip.Tip="Löschen" Click="Delete">
                    <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14"/>
                </Button>
            </Grid>
        </DataTemplate>
    </ui:Screen.Resources>
    <ui:Screen.Styles>
        <Style Selector="StackPanel.section > DockPanel">
            <Setter Property="Margin" Value="10,10,10,2"/>
        </Style>
        <Style Selector="StackPanel.section > ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </ui:Screen.Styles>
    <DockPanel>
        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Rechnungen hinzufügen" Theme="{StaticResource PrimaryButton}" Margin="0,0,0,16" Click="AddFiles"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="16*" MinWidth="480"/>
            </Grid.ColumnDefinitions>
            <Border Theme="{StaticResource Panel}">
                <DockPanel>
                    <ui:SearchBox x:Name="Search" DockPanel.Dock="Top" Width="NaN" Margin="8"/>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PointerPressed="ListPressed">
                            <StackPanel>
                                <StackPanel Classes="section" IsVisible="{Binding HasPending}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Pending.Count}" Theme="{StaticResource Muted}" FontSize="12"/>
                                        <TextBlock Text="Prüfung offen" Theme="{StaticResource FieldLabel}" Margin="0"/>
                                    </DockPanel>
                                    <ListBox x:Name="PendingList" ItemTemplate="{StaticResource InvoiceRowTemplate}" SelectionChanged="SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Classes="section" IsVisible="{Binding HasAutomatic}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Automatic.Count}" Theme="{StaticResource Muted}" FontSize="12"/>
                                        <TextBlock Text="Automatisch geprüft" Theme="{StaticResource FieldLabel}" Margin="0"/>
                                    </DockPanel>
                                    <ListBox x:Name="AutomaticList" ItemTemplate="{StaticResource InvoiceRowTemplate}" SelectionChanged="SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Classes="section" IsVisible="{Binding HasManual}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Manual.Count}" Theme="{StaticResource Muted}" FontSize="12"/>
                                        <TextBlock Text="Manuell geprüft" Theme="{StaticResource FieldLabel}" Margin="0"/>
                                    </DockPanel>
                                    <ListBox x:Name="ManualList" ItemTemplate="{StaticResource InvoiceRowTemplate}" SelectionChanged="SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="Noch keine Rechnungen" Theme="{StaticResource EmptyState}" IsVisible="{Binding Empty}"/>
                        <ui:NoResults Search="{Binding #Search}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
                <Grid x:Name="Intro" Margin="8" IsVisible="{Binding Idle}">
                    <Rectangle Theme="{StaticResource DropZone}" Classes.over="{Binding Dragging}"/>
                    <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                        <PathIcon Theme="{StaticResource DropIcon}"/>
                        <TextBlock Text="Rechnungen hierher ziehen" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="PDF, Bilder (PNG, JPG, TIFF) und XML-Rechnungen."/>
                        <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Gescannte Belege werden gelesen und danach zur Durchsicht vorgelegt; XML-Rechnungen werden direkt übernommen."/>
                    </StackPanel>
                </Grid>
                <ContentControl x:Name="EditorHost" IsVisible="False"/>
            </Grid>
            <Grid Grid.ColumnSpan="3" Margin="8" IsVisible="{Binding DropHint}" IsHitTestVisible="False">
                <Rectangle Theme="{StaticResource DropZone}" Classes="over"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Theme="{StaticResource DropIcon}"/>
                    <TextBlock Text="Zum Hinzufügen loslassen" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</ui:Screen>
