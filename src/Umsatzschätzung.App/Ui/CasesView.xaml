<ui:Screen x:Class="Umsatzschätzung.App.Ui.CasesView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           Margin="24">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Importieren" Style="{StaticResource SecondaryButton}" Click="Import"/>
                <Button Content="Neue Prüfung" Style="{StaticResource PrimaryButton}" Click="StartNew"/>
            </StackPanel>
            <TextBlock Text="Prüfungen" Style="{StaticResource PageTitle}"/>
        </DockPanel>
        <Border x:Name="NewPanel" DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Neue Prüfung" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Bezeichnung *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NewLabel" Width="520" HorizontalAlignment="Left"/>
                <Grid Width="520" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Zeitraum von *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NewFrom"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Zeitraum bis *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NewTo"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Datum als TT.MM.JJJJ" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Anlegen" Style="{StaticResource PrimaryButton}" Click="Create" Margin="0,0,8,0"/>
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Click="CancelNew"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid>
            <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding Cases}" IsReadOnly="True"
                      MouseDoubleClick="OpenSelected" KeyDown="GridKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Case.Label}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Zeitraum" Binding="{Binding Period}" Width="200"/>
                    <DataGridTextColumn Header="Rechnungen" Binding="{Binding Invoices}" Width="110" ElementStyle="{StaticResource Number}"/>
                    <DataGridTextColumn Header="Zuletzt geändert" Binding="{Binding UpdatedAt}" Width="160" ElementStyle="{StaticResource Muted}"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Öffnen" Style="{StaticResource LinkButton}" Click="OpenRow"/>
                                    <Button Content="Löschen" Style="{StaticResource DangerLink}" Click="Delete"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Noch keine Prüfungen" Style="{StaticResource EmptyState}">
                <TextBlock.Visibility>
                    <Binding Path="Empty">
                        <Binding.Converter>
                            <BooleanToVisibilityConverter/>
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Visibility>
            </TextBlock>
        </Grid>
    </DockPanel>
</ui:Screen>
