<ui:Screen x:Class="Umsatzschätzung.App.Ui.MappingView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           xmlns:m="clr-namespace:Umsatzschätzung.Model;assembly=Umsatzschätzung.Core"
           x:DataType="ui:MappingModel"
           Margin="0,12,0,0">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Zuordnung" Theme="{StaticResource PageTitle}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="58*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Theme="{StaticResource Panel}">
                <DockPanel>
                    <ui:SearchBox x:Name="Search" DockPanel.Dock="Top" Margin="8"/>
                    <Grid>
                    <DataGrid x:Name="Groups" Theme="{StaticResource Grid}" IsReadOnly="True" SelectionChanged="GroupSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lieferant" Binding="{Binding Supplier, DataType=ui:LineGroup}" Width="170"/>
                            <DataGridTemplateColumn Header="Position" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:LineGroup">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Positionen" Width="100" SortMemberPath="Count">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="ui:LineGroup">
                                        <TextBlock Text="{Binding Count}" Theme="{StaticResource Number}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Alles zugeordnet" Theme="{StaticResource EmptyState}" IsVisible="{Binding Empty}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Theme="{StaticResource Panel}" Padding="16">
                <Grid>
                    <TextBlock Text="Keine Position gewählt" Theme="{StaticResource EmptyState}" IsVisible="{Binding NoSelection}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,16" ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*">
                                <TextBlock Text="Lieferant" Theme="{StaticResource KeyLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Supplier}" Theme="{StaticResource KeyValue}"/>
                                <TextBlock Grid.Row="1" Text="Artikelnummer" Theme="{StaticResource KeyLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Article}" Theme="{StaticResource KeyValue}"/>
                                <TextBlock Grid.Row="2" Text="Einheit" Theme="{StaticResource KeyLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Unit}" Theme="{StaticResource KeyValue}"/>
                                <TextBlock Grid.Row="3" Text="Positionen" Theme="{StaticResource KeyLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Count}" Theme="{StaticResource KeyValue}"/>
                            </Grid>
                            <StackPanel IsVisible="{Binding ShowCandidates}">
                                <TextBlock Text="Vorschläge werden ermittelt …" Theme="{StaticResource Muted}" IsVisible="{Binding Loading}"/>
                                <TextBlock Text="Keine Vorschläge" Theme="{StaticResource Muted}" IsVisible="{Binding NoCandidates}"/>
                                <ItemsControl ItemsSource="{Binding Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:CandidateRow">
                                            <RadioButton GroupName="Candidates" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Theme="{StaticResource BadgeSuccess}" IsVisible="{Binding IsExact}">
                                                            <TextBlock Text="Exakter Treffer" Theme="{StaticResource BadgeText}"/>
                                                        </Border>
                                                        <Border Theme="{StaticResource BadgeInfo}" IsVisible="{Binding IsLexical}">
                                                            <TextBlock Text="Namensvorschlag" Theme="{StaticResource BadgeText}"/>
                                                        </Border>
                                                        <Border Theme="{StaticResource Badge}" IsVisible="{Binding IsManual}">
                                                            <TextBlock Text="Manuell" Theme="{StaticResource BadgeText}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Confidence}" Theme="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Theme="{StaticResource Card}" IsVisible="{Binding Manual}">
                                <Grid ColumnDefinitions="*,16,160">
                                    <StackPanel>
                                        <TextBlock Text="Zutat *" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Ingredients}" DisplayMemberBinding="{Binding Name, DataType=m:Ingredient}" SelectedItem="{Binding Ingredient, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Faktor *" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Factor, Mode=TwoWay}"/>
                                        <TextBlock Text="Basiseinheiten je Rechnungseinheit" Theme="{StaticResource FieldLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Zuordnen" Theme="{StaticResource PrimaryButton}" IsEnabled="{Binding CanAssign}" Click="Assign" Margin="0,0,8,0"/>
                                <Button Content="{Binding ManualLabel}" Theme="{StaticResource SecondaryButton}" Click="ToggleManual"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</ui:Screen>
