<ui:Screen x:Class="Umsatzschätzung.App.Ui.MappingView"
           xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="clr-namespace:Umsatzschätzung.App.Ui"
           x:DataType="ui:MappingModel"
           Margin="0,12,0,0">
    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="58*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Theme="{StaticResource Panel}">
                <DockPanel>
                    <ui:SearchBox x:Name="Search" DockPanel.Dock="Top" Margin="8"/>
                    <Grid>
                    <ListBox x:Name="Groups" SelectionChanged="GroupSelected" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ui:LineGroup">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsVisible="{Binding NoInvoices}">
                        <TextBlock Text="Noch keine Rechnungen" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Zugeordnet werden Rechnungspositionen zu Zutaten. Fügen Sie zuerst Rechnungen hinzu."/>
                        <Button Content="Zu den Rechnungen" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="GoInvoices"/>
                    </StackPanel>
                    <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsVisible="{Binding AllMapped}">
                        <TextBlock Text="Alles zugeordnet" Theme="{StaticResource SectionHeader}" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Theme="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Jede Rechnungsposition ist einer Zutat zugeordnet."/>
                        <Button Content="Zur Kalkulation" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="GoCalc"/>
                    </StackPanel>
                    <ui:NoResults Search="{Binding #Search}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Theme="{StaticResource Panel}" Padding="16">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Theme="{StaticResource BadgeSuccess}" HorizontalAlignment="Left"
                            Margin="0,0,0,12" IsVisible="{Binding HasAssigned}">
                        <TextBlock Text="{Binding Assigned}" Theme="{StaticResource BadgeText}" TextWrapping="Wrap"/>
                    </Border>
                    <Grid>
                    <TextBlock Text="Keine Position gewählt" Theme="{StaticResource EmptyState}" IsVisible="{Binding NoSelection}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Theme="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,16" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="Artikelnummer" Theme="{StaticResource KeyLabel}" IsVisible="{Binding HasArticle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Article}" Theme="{StaticResource KeyValue}" IsVisible="{Binding HasArticle}"/>
                                <TextBlock Grid.Row="1" Text="Einheit" Theme="{StaticResource KeyLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Unit}" Theme="{StaticResource KeyValue}"/>
                                <TextBlock Grid.Row="2" Text="Menge" Theme="{StaticResource KeyLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Quantity}" Theme="{StaticResource KeyValue}"/>
                            </Grid>
                            <StackPanel IsVisible="{Binding ShowCandidates}">
                                <TextBlock Text="Vorschläge werden ermittelt …" Theme="{StaticResource Muted}" IsVisible="{Binding Loading}"/>
                                <TextBlock Text="Keine Vorschläge" Theme="{StaticResource Muted}" IsVisible="{Binding NoCandidates}"/>
                                <ItemsControl ItemsSource="{Binding Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:CandidateRow">
                                            <RadioButton GroupName="Candidates" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Theme="{StaticResource BadgeSuccess}" IsVisible="{Binding IsExact}">
                                                            <TextBlock Text="Exakter Treffer" Theme="{StaticResource BadgeText}"/>
                                                        </Border>
                                                        <Border Theme="{StaticResource BadgeInfo}" IsVisible="{Binding IsLexical}">
                                                            <TextBlock Text="Namensvorschlag" Theme="{StaticResource BadgeText}"/>
                                                        </Border>
                                                        <Border Theme="{StaticResource Badge}" IsVisible="{Binding IsManual}">
                                                            <TextBlock Text="Manuell" Theme="{StaticResource BadgeText}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Confidence}" Theme="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Grid IsVisible="{Binding Manual}" Margin="0,12,0,0" ColumnDefinitions="*,16,160">
                                <StackPanel>
                                    <TextBlock Text="Zutat *" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ui:IngredientBox ItemsSource="{Binding Ingredients}" SelectedItem="{Binding Ingredient, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Faktor *" Theme="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBox Theme="{StaticResource NumberBox}" Text="{Binding Factor, Mode=TwoWay}"/>
                                    <TextBlock Text="Basiseinheiten je Rechnungseinheit" Theme="{StaticResource FieldLabel}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Zuordnen" Theme="{StaticResource PrimaryButton}" IsEnabled="{Binding CanAssign}" Click="Assign" Margin="0,0,8,0"/>
                                <Button Content="{Binding ManualLabel}" Theme="{StaticResource SecondaryButton}" Click="ToggleManual"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</ui:Screen>
