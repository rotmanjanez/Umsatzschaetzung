<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Umsatzschätzung.App</RootNamespace>
    <AssemblyName>umsatzschätzung</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Ui/Assets/app.ico</ApplicationIcon>
    <!-- Views take a Session and are only ever constructed in code, never fetched
         from the runtime XAML loader by URI, which is all AVLN3001 warns about. -->
    <NoWarn>AVLN3001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    <!-- codesign findet Dateien mit Umlaut im Namen nicht wieder: im Info.plist
         stehen sie normalisiert, auf der Platte nicht. Auf macOS also ohne. -->
    <AssemblyName>umsatzschaetzung</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Ui/Assets/logo.svg" />
    <AvaloniaResource Include="Ui/Assets/logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Umsatzschätzung.Core/Umsatzschätzung.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'">
    <Compile Remove="Platform/Windows/**" />
  </ItemGroup>
</Project>
