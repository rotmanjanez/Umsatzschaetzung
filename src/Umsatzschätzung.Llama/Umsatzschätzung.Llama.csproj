<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Umsatzschätzung.Llama</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <LlmArch>$(RuntimeIdentifier)</LlmArch>
    <LlmArch Condition="'$(LlmArch)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</LlmArch>
    <LlmDll>$(MSBuildThisFileDirectory)..\..\third_party\llama\build\$(LlmArch)\umsatzschaetzung_llm.dll</LlmDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Umsatzschätzung.Core/Umsatzschätzung.Core.csproj" />
    <None Include="$(LlmDll)" Link="umsatzschaetzung_llm.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(LlmDll)')" />
  </ItemGroup>
</Project>
