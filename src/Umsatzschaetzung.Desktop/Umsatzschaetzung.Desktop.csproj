<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64</RuntimeIdentifiers>
    <RootNamespace>Umsatzschaetzung.Desktop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- codesign findet Dateien mit Umlaut im Namen nicht wieder: im Info.plist
         stehen sie normalisiert, auf der Platte nicht. Auf macOS also ohne. -->
    <AssemblyName>umsatzschaetzung</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>../Umsatzschaetzung.App/Ui/Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <AssemblyName>umsatzschätzung</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umsatzschaetzung.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Umsatzschaetzung.App/Umsatzschaetzung.App.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
  </ItemGroup>
</Project>
