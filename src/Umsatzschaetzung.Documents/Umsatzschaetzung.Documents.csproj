<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Umsatzschaetzung</RootNamespace>
    <ModelSet>ocr</ModelSet>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Umsatzschaetzung.Core/Umsatzschaetzung.Core.csproj" />
    <ProjectReference Include="../RapidOcrNet/RapidOcrNet.csproj" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="155.0.8057" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="155.0.8057" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="155.0.8057" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.1" />
