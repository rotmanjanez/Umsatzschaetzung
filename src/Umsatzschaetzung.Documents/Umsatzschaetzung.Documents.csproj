         Metal on macOS. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.EP.WebGpu" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="corpus-ocr" />
    <InternalsVisibleTo Include="eval" />
