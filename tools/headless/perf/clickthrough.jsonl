// Clicking through a filled case, after guide.jsonl built it: what a person does most, each
// step timed with --perf. Import is left to the guide and not looked at here.

// Reopen the case from the list, then walk the tabs twice: cold, then warm
{ "do": "press", "at": { "text": "Gasthaus Zur Linde, Bp 2025" } }
{ "do": "tab", "header": "1. Rechnungen" }
{ "do": "tab", "header": "2. Zuordnung" }
{ "do": "tab", "header": "3. Sortiment" }
{ "do": "tab", "header": "4. Kalkulation" }
{ "do": "tab", "header": "Prüfung" }
{ "do": "tab", "header": "1. Rechnungen" }
{ "do": "tab", "header": "2. Zuordnung" }
{ "do": "tab", "header": "3. Sortiment" }
{ "do": "tab", "header": "4. Kalkulation" }
{ "do": "tab", "header": "1. Rechnungen" }

// Rechnungen: search as one types, then a few invoices opened, looked at and closed
