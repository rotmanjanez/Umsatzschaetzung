{ "do": "select", "at": { "starts": "2022 Domina" } }
{ "do": "deselect", "at": { "name": "Groups" } }
{ "do": "type", "at": { "name": "Search" }, "text": "K" }
{ "do": "type", "at": { "name": "Search" }, "text": "Ka" }
{ "do": "type", "at": { "name": "Search" }, "text": "Kaf" }
{ "do": "type", "at": { "name": "Search" }, "text": "" }

// Sortiment: prices typed into rows
{ "do": "tab", "header": "3. Sortiment" }
{ "do": "type", "at": { "text": "Bier 0,5 l vom Fass", "up": "DataGridRow" }, "text": "4,70" }
{ "do": "focus" }
{ "do": "type", "at": { "text": "Bier 0,5 l vom Fass", "up": "DataGridRow" }, "text": "4,80" }
{ "do": "focus" }

// Kalkulation: its pages, rows picked on each
