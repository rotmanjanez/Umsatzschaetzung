{ "do": "type", "at": { "name": "Search" }, "text": "Me" }
{ "do": "type", "at": { "name": "Search" }, "text": "Met" }
{ "do": "type", "at": { "name": "Search" }, "text": "Metz" }
{ "do": "type", "at": { "name": "Search" }, "text": "" }
{ "do": "open", "number": "2025/0118" }
{ "do": "close", "window": "dialog" }
{ "do": "open", "number": "9120065089" }
{ "do": "close", "window": "dialog" }
{ "do": "open", "number": "R-25-029" }
{ "do": "close", "window": "dialog" }
{ "do": "open", "number": "9120127235" }
{ "do": "close", "window": "dialog" }
{ "do": "open", "number": "2025/0525" }
{ "do": "close", "window": "dialog" }

// Zuordnung: going down the positions one by one, and a search
{ "do": "tab", "header": "2. Zuordnung" }
{ "do": "select", "at": { "starts": "2022 Domina" } }
{ "do": "top", "at": { "name": "Groups" } }
